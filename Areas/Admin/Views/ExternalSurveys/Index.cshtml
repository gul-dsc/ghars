@model List<GharsPlatform.Models.Core.ExternalSurvey>
@using GharsPlatform.Models.Identity
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    ViewData["Title"] = T("Official Surveys", "الاستبيانات الرسمية");
    ViewData["PageTitle"] = ViewData["Title"];
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">@ViewData["Title"]</h1>
        <div class="text-muted">@T("Publish the official survey link and the analysis report received from the Dubai Digital Authority.", "نشر رابط الاستبيان الرسمي والتقرير التحليلي الوارد من هيئة دبي الرقمية.")</div>
    </div>
    <a class="btn btn-primary super-admin-action" asp-area="Admin" asp-controller="ExternalSurveys" asp-action="Create"><i class="bi bi-plus-lg"></i> @T("Add survey", "إضافة استبيان")</a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>@T("Title", "العنوان")</th>
                    <th>@T("Season", "الموسم")</th>
                    <th>@T("Link", "الرابط")</th>
                    <th>@T("Availability", "فترة الإتاحة")</th>
                    <th>@T("Status", "الحالة")</th>
                    <th>@T("Report", "التقرير")</th>
                    <th class="text-end">@T("Actions", "إجراءات")</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td><strong>@s.TitleEn</strong><div class="text-muted small">@s.TitleAr</div></td>
                    <td>@(ar ? s.Season?.TitleAr : s.Season?.TitleEn)</td>
                    <td class="text-truncate" style="max-width:260px;"><a href="@s.ExternalUrl" target="_blank" rel="noopener noreferrer">@s.ExternalUrl</a></td>
                    <td class="small">@(s.StartsAtUtc?.ToString("yyyy-MM-dd") ?? "-") → @(s.EndsAtUtc?.ToString("yyyy-MM-dd") ?? "-")</td>
                    <td><span class="badge @(s.IsActive ? "text-bg-success" : "text-bg-secondary")">@(s.IsActive ? T("Active", "نشط") : T("Inactive", "غير نشط"))</span></td>
                    <td>
                        @if (string.IsNullOrWhiteSpace(s.ReportPdfPath))
                        {
                            <span class="badge text-bg-light border">@T("Not uploaded", "لم يُرفع")</span>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-secondary" href="/protected-files/survey-report/@s.Id" target="_blank" rel="noopener noreferrer">PDF</a>
                            <span class="badge @(s.IsReportPublished ? "text-bg-success" : "text-bg-warning")">@(s.IsReportPublished ? T("Published", "منشور") : T("Unpublished", "غير منشور"))</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@s.Id">@T("Edit", "تعديل")</a>
                        @if (!string.IsNullOrWhiteSpace(s.ReportPdfPath))
                        {
                            <form method="post" asp-action="ToggleReport" asp-route-id="@s.Id" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-success">@(s.IsReportPublished ? T("Hide report", "إخفاء التقرير") : T("Publish report", "نشر التقرير"))</button>
                            </form>
                        }
                        @if (User.IsInRole(RoleNames.SuperAdmin))
                        {
                            <form method="post" asp-action="Delete" asp-route-id="@s.Id" class="d-inline" onsubmit="return confirm('@T("Delete this survey?", "حذف هذا الاستبيان؟")');">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger">@T("Delete", "حذف")</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">@T("No official surveys have been added yet.", "لم تتم إضافة استبيانات رسمية بعد.")</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
