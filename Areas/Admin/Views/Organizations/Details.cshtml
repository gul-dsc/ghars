@model GharsPlatform.Models.Core.Organization
@{
    ViewData["Title"] = "Organization Details";
    ViewData["PageTitle"] = "Organization Details";
}
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <a class="btn btn-sm btn-outline-secondary" href="/Admin/Organizations"><i class="bi bi-arrow-left"></i> Back</a>
    <div class="d-flex gap-2">
        @if (Model.Status == ApprovalStatus.Pending)
        {
            <form method="post" action="/Admin/Organizations/Approve/@Model.Id">
                @Html.AntiForgeryToken()
                <button class="btn btn-sm btn-success" type="submit"><i class="bi bi-check2"></i> Approve</button>
            </form>
            <form method="post" action="/Admin/Organizations/Reject/@Model.Id" class="d-flex gap-2">
                @Html.AntiForgeryToken()
                <input class="form-control form-control-sm" name="reason" placeholder="Rejection reason (optional)" />
                <button class="btn btn-sm btn-danger" type="submit"><i class="bi bi-x"></i> Reject</button>
            </form>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body">
                <h5 class="mb-1">@Model.NameEn</h5>
                <div class="text-muted">@Model.NameAr</div>
                <div class="mt-3 small">
                    <div><strong>Type:</strong> @Model.OrganizationType</div>
                    <div><strong>Email:</strong> @Model.Email</div>
                    <div><strong>Phone:</strong> @Model.Phone</div>
                    <div><strong>City:</strong> @Model.City</div>
                    <div><strong>Website:</strong> @Model.WebsiteUrl</div>
                    <div class="mt-2"><strong>Status:</strong> <span class="badge text-bg-@(Model.Status==ApprovalStatus.Approved?"success":Model.Status==ApprovalStatus.Pending?"warning":"danger")">@Model.Status</span></div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <hr />
                    <div class="small"><strong>Notes:</strong><br />@Model.Notes</div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body">
                <h6 class="fw-semibold"><i class="bi bi-person-lines-fill me-2"></i>Contacts</h6>
                @if (Model.Contacts == null || !Model.Contacts.Any())
                {
                    <div class="text-muted">No contacts.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var c in Model.Contacts.OrderByDescending(x => x.IsPrimary))
                        {
                            <li class="list-group-item">
                                <div class="fw-semibold">@c.FullName @(c.IsPrimary ? "(Primary)" : "")</div>
                                <div class="small text-muted">@c.Email • @c.Phone</div>
                            </li>
                        }
                    </ul>
                }

                <hr />
                <h6 class="fw-semibold"><i class="bi bi-file-earmark me-2"></i>Documents</h6>
                @if (Model.Documents == null || !Model.Documents.Any())
                {
                    <div class="text-muted">No documents.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var d in Model.Documents.OrderByDescending(x => x.UploadedAtUtc))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@d.DocumentType</div>
                                    <div class="small text-muted">@d.OriginalFileName</div>
                                </div>
                                <a class="btn btn-sm btn-outline-primary" href="/protected-files/organization/@d.Id" target="_blank" rel="noopener noreferrer">Open</a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
