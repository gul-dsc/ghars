@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    ViewData["Title"] = T("Organization registered", "تم تسجيل الجهة");
}
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4 p-md-5">
        <h3 class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>@T("Organization registered", "تم تسجيل الجهة")</h3>
        <p class="text-muted">@T("Organization registered. It is pending approval in Organizations.", "تم تسجيل الجهة وهي بانتظار الاعتماد في قائمة الجهات.")</p>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" asp-area="Admin" asp-controller="Organizations" asp-action="Index">@T("Go to Organizations", "الانتقال إلى قائمة الجهات")</a>
            <a class="btn btn-outline-secondary" href="/">@T("Back to home", "العودة إلى الرئيسية")</a>
        </div>
    </div>
</div>
