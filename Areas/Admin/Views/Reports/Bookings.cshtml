@model List<GharsPlatform.Models.Core.BookingRequest>
@using GharsPlatform.Helpers
@using GharsPlatform.Models.Core
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    ViewData["Title"] = T("Bookings report", "تقرير الحجوزات");
    ViewData["PageTitle"] = ViewData["Title"];
    string Org(Organization? o) => o == null ? "—" : (ar && !string.IsNullOrWhiteSpace(o.NameAr) ? o.NameAr : o.NameEn);
    string TypeText(ActivityType t) => t switch { ActivityType.Lecture => T("Lecture", "محاضرة"), ActivityType.Event => T("Event", "فعالية"), ActivityType.Workshop => T("Workshop", "ورشة عمل"), ActivityType.TrainingProgram => T("Training", "تدريب"), ActivityType.Course => T("Course", "دورة"), ActivityType.Activity => T("Activity", "نشاط"), _ => t.ToString() };
    var existing = Model.Count(x => !BookingSource.IsCustom(x));
    var custom = Model.Count - existing;
}
@* Both booking paths appear here. A Custom Program Request has no Activity row, so every column
   below reads from the booking itself and falls back to the Activity only where one exists —
   joining through Activities would have made custom requests disappear from this report. *@
<div class="d-flex flex-wrap gap-3 align-items-center mb-3 small">
    <span>@T("Bookings", "الحجوزات"): <strong>@Model.Count</strong></span>
    <span><i class="bi bi-collection me-1" aria-hidden="true"></i>@T("Existing program", "برنامج قائم"): <strong>@existing</strong></span>
    <span><i class="bi bi-pencil-square me-1" aria-hidden="true"></i>@T("Custom program", "برنامج مخصص"): <strong>@custom</strong></span>
</div>
<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>@T("ID", "الرقم")</th>
                <th>@T("Club", "النادي")</th>
                <th>@T("Implementing entity", "الجهة المنفذة")</th>
                <th>@T("Program", "البرنامج")</th>
                <th>@T("Booking source", "مصدر الحجز")</th>
                <th>@T("Type", "النوع")</th>
                <th>@T("Proposed date", "التاريخ المقترح")</th>
                <th>@T("Participants", "المشاركون")</th>
                <th>@T("Status", "الحالة")</th>
                <th>@T("Created", "تاريخ الإنشاء")</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.Id</td>
                    <td>@(b.Organization == null ? "" : Org(b.Organization))</td>
                    <td>@Org(b.PartnerOrganization)</td>
                    <td>@BookingSource.Title(b)</td>
                    <td>
                        <span class="badge rounded-pill @BookingSource.BadgeClass(b)">
                            <i class="bi @BookingSource.Icon(b) me-1" aria-hidden="true"></i>@BookingSource.Label(b)
                        </span>
                    </td>
                    <td>@TypeText(b.Activity?.Type ?? b.RequestedActivityType)</td>
                    <td>@(b.ProposedStartDateTime?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                    <td>@b.RequestedSeats</td>
                    <td>@BookingStatusText.Label(b.Status)</td>
                    <td>@b.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="10" class="text-muted p-3">@T("No bookings recorded.", "لا توجد حجوزات مسجلة.")</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
