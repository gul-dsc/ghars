@model GharsPlatform.Models.Core.Certificate
@{
    ViewData["Title"] = "Certificate Verification";
}
<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <h3 class="mb-0"><i class="bi bi-award me-2"></i>Certificate Verification</h3>
                    <span class="badge @(Model.Status == CertificateStatus.Issued ? "text-bg-success" : "text-bg-danger")">@Model.Status</span>
                </div>
                <hr />
                <dl class="row mb-0">
                    <dt class="col-sm-4">Certificate No</dt>
                    <dd class="col-sm-8">@Model.CertificateNo</dd>

                    <dt class="col-sm-4">Issued At (UTC)</dt>
                    <dd class="col-sm-8">@Model.IssuedAtUtc.ToString("yyyy-MM-dd HH:mm")</dd>

                    <dt class="col-sm-4">Activity</dt>
                    <dd class="col-sm-8">@Model.Activity?.TitleEn</dd>
                </dl>

                @if (Model.Status == CertificateStatus.Revoked)
                {
                    <div class="alert alert-danger mt-4">
                        This certificate has been revoked.
                        @if (!string.IsNullOrWhiteSpace(Model.RevokeReason))
                        {
                            <div class="small mt-1">Reason: @Model.RevokeReason</div>
                        }
                    </div>
                }

                <div class="mt-4">
                    <a class="btn btn-primary" href="/">Back to Home</a>
                </div>
            </div>
        </div>
    </div>
</div>
