@model GharsPlatform.ViewModels.PartnerProgramVm
@using GharsPlatform.Models.Core
@using GharsPlatform.ViewModels
@using System.Globalization
@{
 var ar=CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar"; string T(string e,string a)=>ar?a:e;
 var seasons=ViewBag.Seasons as List<Season> ?? new();
 var org=ViewBag.Organization as Organization;
 string AudienceText(string a)=>a switch{"Players"=>T("Players","لاعبون"),"Coaches"=>T("Coaches","مدربون"),"Staff"=>T("Staff","موظفون"),"Administrators"=>T("Administrators","إداريون"),"Parents"=>T("Parents","أولياء أمور"),"Others"=>T("Others","أخرى"),_=>a};
 var locked=Model.HasBookings;
}

@* Rendered only when there is something to say. The tag helper emits its container either way, so
   without this guard a valid form shows an empty red alert. *@
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert">
        <h2 class="h6 mb-2">@T("Please correct the following:","يرجى تصحيح ما يلي:")</h2>
        <div asp-validation-summary="All" class="mb-0"></div>
    </div>
}

@if(locked)
{
    <div class="required-action-banner">
        <i class="bi bi-lock me-2"></i>@T("Clubs have already requested this program, so its season and type are locked to keep those booking records accurate. Everything else remains editable.",
                                          "توجد طلبات حجز على هذا البرنامج، لذلك تم تثبيت الموسم والنوع للحفاظ على دقة سجلات الحجز. أما بقية الحقول فتبقى قابلة للتعديل.")
    </div>
}

<div class="card shadow-sm border-0 rounded-4 mb-3">
    <div class="card-body">
        <h2 class="h5 mb-3">@T("Program details","تفاصيل البرنامج")</h2>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">@T("Implementing Entity","الجهة المنفذة")</label>
                @* Ownership is server-derived and shown read-only. There is deliberately no input
                   here: the posted form carries no organization id at all. *@
                <div class="booking-readonly-value">@(org is null ? "—" : (ar && !string.IsNullOrWhiteSpace(org.NameAr) ? org.NameAr : org.NameEn))</div>
            </div>

            <div class="col-md-3">
                @* The label binds to the control only when there is one: a locked field renders as
                   read-only text, and a "for" pointing at nothing helps no reader. *@
                @if(locked)
                {
                    <label class="form-label">@T("Sports Season","الموسم الرياضي")</label>
                    <div class="booking-readonly-value">@(seasons.FirstOrDefault(s=>s.Id==Model.SeasonId) is Season s0 ? (ar?s0.TitleAr:s0.TitleEn) : "—")</div>
                }
                else
                {
                    <label class="form-label" asp-for="SeasonId">@T("Sports Season","الموسم الرياضي")</label>
                    <select class="form-select" asp-for="SeasonId">
                        <option value="0">@T("Select a season","اختر الموسم")</option>
                        @foreach(var s in seasons){<option value="@s.Id" selected="@(Model.SeasonId==s.Id)">@(ar?s.TitleAr:s.TitleEn)</option>}
                    </select>
                }
            </div>

            <div class="col-md-3">
                @if(locked)
                {
                    <label class="form-label">@T("Type","النوع")</label>
                    <div class="booking-readonly-value">@(Model.Type==ActivityType.Workshop ? T("Workshop","ورشة عمل") : T("Training","تدريب"))</div>
                }
                else
                {
                    <label class="form-label" asp-for="Type">@T("Type","النوع")</label>
                    <select class="form-select" asp-for="Type">
                        <option value="@ActivityType.TrainingProgram" selected="@(Model.Type==ActivityType.TrainingProgram)">@T("Training","تدريب")</option>
                        <option value="@ActivityType.Workshop" selected="@(Model.Type==ActivityType.Workshop)">@T("Workshop","ورشة عمل")</option>
                    </select>
                }
            </div>

            <div class="col-md-6">
                <label class="form-label" asp-for="TitleEn">@T("Title (English)","العنوان بالإنجليزية")</label>
                <input class="form-control" asp-for="TitleEn" dir="ltr" maxlength="250" />
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="TitleAr">@T("Title (Arabic)","العنوان بالعربية")</label>
                <input class="form-control" asp-for="TitleAr" dir="rtl" maxlength="250" />
            </div>

            <div class="col-md-6">
                <label class="form-label" asp-for="DescriptionEn">@T("Description (English)","الوصف بالإنجليزية")</label>
                <textarea class="form-control" asp-for="DescriptionEn" rows="4" dir="ltr" maxlength="3000"></textarea>
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="DescriptionAr">@T("Description (Arabic)","الوصف بالعربية")</label>
                <textarea class="form-control" asp-for="DescriptionAr" rows="4" dir="rtl" maxlength="3000"></textarea>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4 mb-3">
    <div class="card-body">
        <h2 class="h5 mb-3">@T("Target Audience","الفئة المستهدفة")</h2>
        <div class="d-flex flex-wrap gap-3">
            @foreach(var a in PartnerProgramVm.AllowedAudiences)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="TargetAudiences" value="@a" id="aud-@a" checked="@(Model.TargetAudiences.Contains(a))" />
                    <label class="form-check-label" for="aud-@a">@AudienceText(a)</label>
                </div>
            }
        </div>
        <div class="mt-3">
            <label class="form-label" asp-for="OtherTargetAudience">@T("If Others, please describe","إذا اخترتم أخرى، يرجى التوضيح")</label>
            <input class="form-control" asp-for="OtherTargetAudience" maxlength="150" />
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4 mb-3">
    <div class="card-body">
        <h2 class="h5 mb-3">@T("Delivery and availability","التنفيذ والإتاحة")</h2>
        <p class="text-muted small">
            @T("The session date and time are indicative — a club may propose a different slot when it requests this program.",
               "تاريخ الجلسة ووقتها استرشاديان — ويمكن للنادي اقتراح موعد مختلف عند طلب البرنامج.")
        </p>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label" asp-for="SessionDate">@T("Indicative session date","تاريخ الجلسة الاسترشادي")</label>
                <input class="form-control" type="date" asp-for="SessionDate" />
            </div>
            <div class="col-md-4">
                <label class="form-label" asp-for="SessionStartTime">@T("Start time","وقت البداية")</label>
                <input class="form-control" type="time" asp-for="SessionStartTime" />
            </div>
            <div class="col-md-4">
                <label class="form-label" asp-for="SessionEndTime">@T("End time","وقت النهاية")</label>
                <input class="form-control" type="time" asp-for="SessionEndTime" />
            </div>

            <div class="col-md-4">
                <label class="form-label" asp-for="Capacity">@T("Capacity","السعة")</label>
                <input class="form-control" type="number" min="1" max="5000" asp-for="Capacity" />
            </div>
            <div class="col-md-4">
                <label class="form-label" asp-for="AvailableFrom">@T("Available from (optional)","متاح من (اختياري)")</label>
                <input class="form-control" type="date" asp-for="AvailableFrom" />
            </div>
            <div class="col-md-4">
                <label class="form-label" asp-for="AvailableUntil">@T("Available until (optional)","متاح حتى (اختياري)")</label>
                <input class="form-control" type="date" asp-for="AvailableUntil" />
            </div>

            <div class="col-md-6">
                <label class="form-label" asp-for="LocationEn">@T("Location (English, optional)","الموقع بالإنجليزية (اختياري)")</label>
                <input class="form-control" asp-for="LocationEn" dir="ltr" maxlength="300" />
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="LocationAr">@T("Location (Arabic, optional)","الموقع بالعربية (اختياري)")</label>
                <input class="form-control" asp-for="LocationAr" dir="rtl" maxlength="300" />
            </div>
        </div>
    </div>
</div>

@* Supporting documents. Optional at every stage, including submission: a program that needs no
   brochure is not an incomplete program, so nothing here can block sending it for approval.

   The files are stored outside wwwroot and served only through /protected-files, which decides who
   may read each one from the program's own state — which is why the visibility note below is a
   statement of what the server enforces, not a request to the partner. *@
<div class="card shadow-sm border-0 rounded-4 mb-3">
    <div class="card-body">
        <h2 class="h5 mb-1">@T("Supporting documents","المستندات الداعمة")</h2>
        <p class="text-muted small">
            @T("Optional. Attach the program outline, brochure, session plan, trainer profile or any material a club or a DSC reviewer should see before deciding.",
               "اختياري. أرفقوا مخطط البرنامج أو الكتيّب أو خطة الجلسة أو السيرة الذاتية للمدرب أو أي مادة يحتاج النادي أو مراجع المجلس للاطلاع عليها قبل اتخاذ القرار.")
        </p>

        @if (Model.ExistingAttachments.Count > 0)
        {
            <div class="mb-3">
                <h3 class="h6 mb-2">@T("Attached documents","المستندات المرفقة")</h3>
                <ul class="list-unstyled mb-1">
                    @foreach (var att in Model.ExistingAttachments)
                    {
                        var label = string.IsNullOrWhiteSpace(att.OriginalFileName) ? T("Document","مستند") : att.OriginalFileName!;
                        <li class="border-bottom py-2 d-flex align-items-center justify-content-between gap-3 flex-wrap">
                            <a class="text-break" href="/protected-files/program-attachment/@att.Id">
                                <i class="bi bi-paperclip me-1" aria-hidden="true"></i>@label
                            </a>
                            <div class="form-check flex-shrink-0 mb-0">
                                @* Removal is a checkbox rather than an instant delete button: it is
                                   part of the same save the rest of the form is, so a partner who
                                   changes their mind simply does not save. *@
                                <input class="form-check-input" type="checkbox" name="RemoveAttachmentIds"
                                       value="@att.Id" id="rm-att-@att.Id" />
                                <label class="form-check-label small" for="rm-att-@att.Id">@T("Remove","إزالة")</label>
                            </div>
                        </li>
                    }
                </ul>
                <div class="form-text">@T("Ticked documents are removed when you save.","تُزال المستندات المحددة عند الحفظ.")</div>
            </div>
        }

        <div>
            <label class="form-label" asp-for="Attachments">@T("Add documents","إضافة مستندات")</label>
            <input class="form-control" type="file" multiple asp-for="Attachments"
                   accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.png,.jpg,.jpeg" />
            <div class="form-text">
                @T($"PDF, Word, PowerPoint, Excel or image. Up to 25 MB per file and {PartnerProgramVm.MaxAttachments} documents per program.",
                   $"PDF أو Word أو PowerPoint أو Excel أو صورة. بحد أقصى 25 ميجابايت لكل ملف و{PartnerProgramVm.MaxAttachments} مستندات لكل برنامج.")
            </div>
            <div class="form-text">
                <i class="bi bi-shield-lock me-1" aria-hidden="true"></i>@T("Documents follow the program: only your entity and DSC reviewers can open them until the program is approved.",
                                                                            "تتبع المستندات حالة البرنامج: لا يمكن فتحها إلا من جهتكم ومراجعي المجلس إلى أن يتم اعتماد البرنامج.")
            </div>
        </div>
    </div>
</div>
