@model GharsPlatform.Models.Core.MediaAlbum
@using GharsPlatform.Models.Core
@using GharsPlatform.Models.Identity
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    string L(string? en, string? arText) => ar ? (string.IsNullOrWhiteSpace(arText) ? en ?? "" : arText) : (en ?? arText ?? "");
    string TypeText(MediaType t) => t switch
    {
        MediaType.Image => T("Image", "صورة"),
        MediaType.Video => T("Video", "فيديو"),
        MediaType.Pdf => T("PDF", "ملف PDF"),
        _ => T("Media", "وسائط")
    };
    var albumTitle = L(Model.TitleEn, Model.TitleAr);
    var linkedTo = Model.Activity != null ? L(Model.Activity.TitleEn, Model.Activity.TitleAr)
        : Model.Organization != null ? L(Model.Organization.NameEn, Model.Organization.NameAr)
        : T("General album", "ألبوم عام");
    var deleteItemConfirm = T("Delete this media item from the album? This cannot be undone.", "حذف عنصر الوسائط هذا من الألبوم؟ لا يمكن التراجع عن هذا الإجراء.");
    ViewData["Title"] = albumTitle;
    ViewData["PageTitle"] = T("Manage album", "إدارة الألبوم");
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">@T("Manage album items", "إدارة عناصر الألبوم")</h1>
        <div class="text-muted">@albumTitle</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Gallery" asp-action="Index">@T("Back to albums", "العودة إلى الألبومات")</a>
        <a class="btn btn-outline-info" asp-area="" asp-controller="Gallery" asp-action="Details" asp-route-id="@Model.Id" target="_blank"><i class="bi bi-eye"></i> @T("Public preview", "معاينة الصفحة العامة")</a>
        @if (User.IsInRole(RoleNames.SuperAdmin))
        {
            <a class="btn btn-outline-primary" asp-area="Admin" asp-controller="Gallery" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil-square"></i> @T("Edit album details", "تعديل بيانات الألبوم")</a>
            <a class="btn btn-primary" asp-area="Admin" asp-controller="Gallery" asp-action="AddItem" asp-route-albumId="@Model.Id"><i class="bi bi-plus-lg"></i> @T("Add photo, video or PDF", "إضافة صورة أو فيديو أو ملف PDF")</a>
        }
    </div>
</div>

<div class="card p-3 rounded-4 border-0 shadow-sm mb-3">
    <div class="row g-3 align-items-center">
        @if(!string.IsNullOrWhiteSpace(Model.CoverImagePath))
        {
            <div class="col-md-2"><img src="@GharsPlatform.Helpers.GalleryMediaUrls.AlbumCover(Model)" alt="@T("Album cover", "غلاف الألبوم")" class="img-fluid rounded-4" style="max-height:130px;object-fit:cover" /></div>
        }
        <div class="col">
            <h5 class="mb-1">@Model.TitleEn</h5>
            <div class="text-muted mb-2">@Model.TitleAr</div>
            <p class="mb-1">@Model.DescriptionEn</p>
            <div class="text-muted small">@Model.DescriptionAr</div>
            <div class="mt-2">
                <span class="badge @(Model.IsPublic ? "text-bg-success" : "text-bg-secondary")">@(Model.IsPublic ? T("Published", "منشور") : T("Hidden", "مخفي"))</span>
                <span class="text-muted ms-2">@Model.AlbumDate.ToString("yyyy-MM-dd")</span>
                <span class="text-muted ms-2">@T("Linked to:", "مرتبط بـ:") <bdi>@linkedTo</bdi></span>
            </div>
        </div>
    </div>
</div>

<div class="card rounded-4 border-0 shadow-sm overflow-hidden mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <div>
            <strong>@T("Album media items", "عناصر الوسائط في الألبوم")</strong>
            <div class="text-muted small">@T("Edit, replace, reorder or delete the photos, videos and PDF files in this album.", "عدّلوا الصور والفيديوهات وملفات PDF في هذا الألبوم أو استبدلوها أو أعيدوا ترتيبها أو احذفوها.")</div>
        </div>
        @if (User.IsInRole(RoleNames.SuperAdmin))
        {
            <a class="btn btn-success btn-sm" asp-area="Admin" asp-controller="Gallery" asp-action="AddItem" asp-route-albumId="@Model.Id"><i class="bi bi-plus-lg"></i> @T("Add item", "إضافة عنصر")</a>
        }
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th style="width:90px">@T("Preview", "معاينة")</th>
                    <th>@T("Caption", "الوصف المختصر")</th>
                    <th>@T("Type", "النوع")</th>
                    <th>@T("Source", "المصدر")</th>
                    <th>@T("Order", "الترتيب")</th>
                    <th class="text-end">@T("Actions", "إجراءات")</th>
                </tr>
            </thead>
            <tbody>
            @foreach(var item in Model.Items.OrderBy(x=>x.SortOrder))
            {
                var source = GharsPlatform.Helpers.GalleryMediaUrls.AlbumItem(item) ?? "";
                <tr>
                    <td>
                        @if(item.MediaType == MediaType.Image && !string.IsNullOrWhiteSpace(item.FilePath))
                        {
                            <img src="@GharsPlatform.Helpers.GalleryMediaUrls.AlbumItem(item)" alt="" class="rounded" style="width:70px;height:52px;object-fit:cover" />
                        }
                        else if(item.MediaType == MediaType.Video)
                        {
                            <div class="rounded bg-dark text-white d-flex align-items-center justify-content-center" style="width:70px;height:52px"><i class="bi bi-play-circle-fill fs-4"></i></div>
                        }
                        else
                        {
                            <div class="rounded bg-light d-flex align-items-center justify-content-center" style="width:70px;height:52px"><i class="bi bi-file-earmark-pdf fs-4"></i></div>
                        }
                    </td>
                    <td><strong>@(item.CaptionEn ?? T("Untitled media", "وسائط بلا عنوان"))</strong><div class="text-muted small">@item.CaptionAr</div></td>
                    <td><span class="badge text-bg-secondary">@TypeText(item.MediaType)</span></td>
                    <td class="small text-truncate" style="max-width:320px" dir="ltr">@source</td>
                    <td>@item.SortOrder</td>
                    <td class="text-end">
                        @if (User.IsInRole(RoleNames.SuperAdmin))
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-area="Admin" asp-controller="Gallery" asp-action="EditItem" asp-route-id="@item.Id"><i class="bi bi-pencil-square"></i> @T("Edit item", "تعديل العنصر")</a>
                            <form method="post" asp-area="Admin" asp-controller="Gallery" asp-action="DeleteItem" asp-route-id="@item.Id" class="d-inline"
                                  data-confirm="@deleteItemConfirm" data-confirm-ok="@T("Delete", "حذف")">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> @T("Delete", "حذف")</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if(!Model.Items.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-4">@T("No media yet. Use Add item to upload a photo, video or PDF file.", "لا توجد وسائط بعد. استخدموا زر إضافة عنصر لرفع صورة أو فيديو أو ملف PDF.")</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="row g-3">
@foreach(var item in Model.Items.OrderBy(x=>x.SortOrder))
{
    <div class="col-md-4">
        <div class="card h-100 rounded-4 border-0 shadow-sm overflow-hidden">
            <div class="bg-light d-flex align-items-center justify-content-center" style="height:190px;">
            @if(item.MediaType == MediaType.Image && !string.IsNullOrWhiteSpace(item.FilePath))
            { <img src="@GharsPlatform.Helpers.GalleryMediaUrls.AlbumItem(item)" alt="" style="width:100%;height:190px;object-fit:cover" /> }
            else if(item.MediaType == MediaType.Video)
            { <i class="bi bi-play-circle-fill" style="font-size:4rem"></i> }
            else
            { <i class="bi bi-file-earmark-pdf" style="font-size:4rem"></i> }
            </div>
            <div class="card-body">
                <span class="badge text-bg-secondary">@TypeText(item.MediaType)</span>
                <h6 class="mt-2">@(ar ? (item.CaptionAr ?? item.CaptionEn ?? "عنصر وسائط") : (item.CaptionEn ?? item.CaptionAr ?? "Media item"))</h6>
                <div class="text-muted small">@T("Order:", "الترتيب:") @item.SortOrder</div>
                @if (User.IsInRole(RoleNames.SuperAdmin))
                {
                    <div class="d-flex gap-2 mt-2">
                        <a class="btn btn-sm btn-outline-primary" asp-area="Admin" asp-controller="Gallery" asp-action="EditItem" asp-route-id="@item.Id">@T("Edit item", "تعديل العنصر")</a>
                        <form method="post" asp-area="Admin" asp-controller="Gallery" asp-action="DeleteItem" asp-route-id="@item.Id" class="d-inline"
                              data-confirm="@deleteItemConfirm" data-confirm-ok="@T("Delete", "حذف")">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-danger">@T("Delete", "حذف")</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
}
</div>
