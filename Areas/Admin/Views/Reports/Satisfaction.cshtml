@model List<GharsPlatform.Controllers.Admin.ReportsController.SatisfactionRow>
@{
    ViewData["Title"] = "Satisfaction Report";
    ViewData["PageTitle"] = "Satisfaction Report";
}
<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>Question</th>
                <th>Avg Stars</th>
                <th>Responses</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td class="fw-semibold">@r.QuestionEn</td>
                    <td>@String.Format("{0:0.00}", r.AvgStars)</td>
                    <td>@r.Count</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
