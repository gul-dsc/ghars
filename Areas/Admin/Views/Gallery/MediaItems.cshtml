@model List<GharsPlatform.Models.Core.GalleryItem>
@using GharsPlatform.Helpers
@using GharsPlatform.Models.Core
@using GharsPlatform.Models.Identity
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    ViewData["Title"] = T("Ghars Channel Content", "محتوى قناة غرس");
    ViewData["PageTitle"] = ViewData["Title"];
    var seasons = ViewBag.Seasons as List<Season> ?? new();
    var orgs = ViewBag.Organizations as List<Organization> ?? new();
    var selectedSeasonId = ViewBag.SelectedSeasonId as int?;
    var selectedOrganizationId = ViewBag.SelectedOrganizationId as int?;
    var selectedMediaType = ViewBag.SelectedMediaType as GalleryMediaType?;
    var selectedSource = ViewBag.SelectedSource as string;
    var selectedApprovalStatus = ViewBag.SelectedApprovalStatus as ChannelApprovalStatus?;
    var pendingReview = ViewBag.PendingReviewCount as int? ?? 0;
    string N(Organization? o) => ar ? (o?.NameAr ?? o?.NameEn ?? "-") : (o?.NameEn ?? o?.NameAr ?? "-");
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">@ViewData["Title"]</h1>
        <div class="text-muted">
            @T("Club media arrives automatically from agenda entries. Implementing entities submit awareness and educational content for approval, and Council staff can add official photos, videos and press coverage.",
               "تصل وسائط الأندية تلقائياً من إدخالات الأجندة. وتقدّم الجهات المنفذة محتوى توعوياً وتعليمياً للاعتماد، ويمكن لموظفي المجلس إضافة الصور والفيديوهات الرسمية والتغطيات الصحفية.")
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Gallery" asp-action="Index">@T("Albums", "الألبومات")</a>
        @if (User.IsInRole(RoleNames.SuperAdmin))
        {
            <a class="btn btn-primary super-admin-action" asp-area="Admin" asp-controller="Gallery" asp-action="CreateMediaItem">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> @T("Add media", "إضافة وسائط")
            </a>
        }
    </div>
</div>

@if (pendingReview > 0)
{
    <div class="alert alert-warning rounded-4 border-0 d-flex flex-wrap align-items-center gap-2">
        <i class="bi bi-hourglass-split" aria-hidden="true"></i>
        <span>@T($"{pendingReview} channel submission(s) awaiting review.", $"{pendingReview} محتوى بانتظار المراجعة.")</span>
        <a class="btn btn-sm btn-warning ms-auto" href="/Admin/Gallery/MediaItems?approvalStatus=@ChannelApprovalStatus.SubmittedForApproval">
            @T("Open review queue", "فتح قائمة المراجعة")
        </a>
    </div>
}

<form method="get" class="card p-3 rounded-4 border-0 shadow-sm mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label" for="f-ch-season">@T("Season", "الموسم")</label>
            <select class="form-select" id="f-ch-season" name="seasonId">
                <option value="">@T("All", "الكل")</option>
                @foreach (var s in seasons) { <option value="@s.Id" selected="@(selectedSeasonId == s.Id)">@(ar ? s.TitleAr : s.TitleEn)</option> }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="f-ch-org">@T("Club / entity", "النادي / الجهة")</label>
            <select class="form-select" id="f-ch-org" name="organizationId">
                <option value="">@T("All", "الكل")</option>
                @foreach (var o in orgs) { <option value="@o.Id" selected="@(selectedOrganizationId == o.Id)">@N(o)</option> }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="f-ch-type">@T("Media type", "نوع الوسائط")</label>
            <select class="form-select" id="f-ch-type" name="mediaType">
                <option value="">@T("All", "الكل")</option>
                @foreach (GalleryMediaType t in Enum.GetValues(typeof(GalleryMediaType))) { <option value="@t" selected="@(selectedMediaType == t)">@t</option> }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="f-ch-source">@T("Source", "المصدر")</label>
            <select class="form-select" id="f-ch-source" name="source">
                <option value="">@T("All", "الكل")</option>
                <option value="agenda" selected="@(selectedSource == "agenda")">@T("Club agenda", "أجندة النادي")</option>
                <option value="partner" selected="@(selectedSource == "partner")">@T("Implementing entity", "جهة منفذة")</option>
                <option value="dsc" selected="@(selectedSource == "dsc")">@T("DSC / Press", "المجلس / صحفي")</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="f-ch-approval">@T("Review status", "حالة المراجعة")</label>
            <select class="form-select" id="f-ch-approval" name="approvalStatus">
                <option value="">@T("All", "الكل")</option>
                @foreach (ChannelApprovalStatus s in Enum.GetValues(typeof(ChannelApprovalStatus))) { <option value="@s" selected="@(selectedApprovalStatus == s)">@ChannelWorkflow.StatusLabel(s)</option> }
            </select>
        </div>
        <div class="col-md-12 d-flex flex-wrap gap-2">
            <button class="btn btn-outline-primary">@T("Filter", "تصفية")</button>
            <a class="btn btn-outline-secondary" href="/Admin/Gallery/MediaItems">@T("Reset", "إعادة ضبط")</a>
        </div>
    </div>
</form>

<div class="card rounded-4 border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" style="width:90px">@T("Preview", "معاينة")</th>
                    <th scope="col">@T("Title", "العنوان")</th>
                    <th scope="col">@T("Source", "المصدر")</th>
                    <th scope="col">@T("Category", "التصنيف")</th>
                    <th scope="col">@T("Club / entity", "النادي / الجهة")</th>
                    <th scope="col">@T("Date", "التاريخ")</th>
                    <th scope="col">@T("Status", "الحالة")</th>
                    <th scope="col" class="text-end">@T("Actions", "إجراءات")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var category = ChannelWorkflow.ResolveCategory(item);
                    var isPartnerContent = item.ApprovalStatus.HasValue;
                    <tr>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.FilePath) && !ChannelWorkflow.IsVideo(item))
                            {
                                @* Served through the authorized endpoint so hidden media stays hidden outside DSC. *@
                                <img src="/protected-files/gallery/@item.Id" class="rounded" style="width:70px;height:52px;object-fit:cover" alt="@item.TitleEn" />
                            }
                            else
                            {
                                <div class="rounded bg-light d-flex align-items-center justify-content-center" style="width:70px;height:52px">
                                    <i class="bi @(ChannelWorkflow.IsVideo(item) ? "bi-play-circle" : ChannelWorkflow.CategoryIcon(category)) fs-5" aria-hidden="true"></i>
                                </div>
                            }
                        </td>
                        <td><strong>@item.TitleEn</strong><div class="text-muted small">@item.TitleAr</div></td>
                        <td><span class="badge @ChannelWorkflow.SourceBadgeClass(item)">@ChannelWorkflow.SourceLabel(item, item.Organization?.OrganizationType)</span></td>
                        <td>@ChannelWorkflow.CategoryLabel(category)</td>
                        <td>@N(item.Organization)</td>
                        <td>@item.MediaDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            @* Partner content shows its review state; club and DSC media show publication. *@
                            @if (isPartnerContent)
                            {
                                <span class="badge @ChannelWorkflow.StatusBadgeClass(item.ApprovalStatus)">
                                    <i class="bi @ChannelWorkflow.StatusIcon(item.ApprovalStatus) me-1" aria-hidden="true"></i>@ChannelWorkflow.StatusLabel(item.ApprovalStatus)
                                </span>
                            }
                            else
                            {
                                <span class="badge @(item.IsPublished ? "text-bg-success" : "text-bg-secondary")">
                                    @(item.IsPublished ? T("Published", "منشور") : T("Hidden", "مخفي"))
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex flex-wrap gap-1 justify-content-end">
                                @if (isPartnerContent)
                                {
                                    <a class="btn btn-sm @(ChannelWorkflow.DscCanReview(item.ApprovalStatus) ? "btn-primary" : "btn-outline-secondary")"
                                       href="/Admin/Gallery/ChannelReview/@item.Id">
                                        @(ChannelWorkflow.DscCanReview(item.ApprovalStatus) ? T("Review", "مراجعة") : T("Open", "فتح"))
                                    </a>
                                }
                                @if (User.IsInRole(RoleNames.SuperAdmin))
                                {
                                    <form method="post" asp-area="Admin" asp-controller="Gallery" asp-action="ToggleMediaItem" asp-route-id="@item.Id" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-secondary">@(item.IsPublished ? T("Hide", "إخفاء") : T("Publish", "نشر"))</button>
                                    </form>
                                    <form method="post" asp-area="Admin" asp-controller="Gallery" asp-action="DeleteMediaItem" asp-route-id="@item.Id" class="d-inline"
                                          onsubmit="return confirm('@T("Remove this media item from the channel?", "إزالة هذه الوسائط من القناة؟")');">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-danger">@T("Remove", "إزالة")</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">@T("No content found for the selected filters.", "لا يوجد محتوى وفق خيارات التصفية المحددة.")</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
