@model GharsPlatform.Controllers.Admin.SurveysController.SurveyVm
@{
    ViewData["Title"] = "Create Survey";
    ViewData["PageTitle"] = "Create Survey";
    var activities = ViewBag.Activities as List<GharsPlatform.Models.Core.Activity> ?? new();
}
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <form method="post">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label">Activity</label>
                    <select class="form-select" asp-for="ActivityId">
                        @foreach (var a in activities)
                        {
                            <option value="@a.Id">@a.TitleEn (@a.StartDateTime.ToString("yyyy-MM-dd"))</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Active</label>
                    <div class="form-check mt-2">
                        <input class="form-check-input" asp-for="IsActive" />
                        <label class="form-check-label">Enabled</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Title (EN)</label>
                    <input class="form-control" asp-for="TitleEn" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Title (AR)</label>
                    <input class="form-control" asp-for="TitleAr" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Opens At (UTC)</label>
                    <input class="form-control" asp-for="OpensAtUtc" type="datetime-local" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Closes At (UTC)</label>
                    <input class="form-control" asp-for="ClosesAtUtc" type="datetime-local" />
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a class="btn btn-outline-secondary" href="/Admin/Surveys">Back</a>
                <button class="btn btn-primary" type="submit">Create</button>
            </div>

            <div class="small text-muted mt-3">
                Default questions are automatically created (overall satisfaction, content quality, recommend, comments).
            </div>
            <div class="text-danger small mt-2" asp-validation-summary="All"></div>
        </form>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
