@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    ViewData["Title"] = T("Check your email", "تحقق من بريدك الإلكتروني");
}
<div class="row justify-content-center">
    <div class="col-md-6 col-xl-5">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <h3 class="mb-3">@T("Check your email", "تحقق من بريدك الإلكتروني")</h3>
                <p>@T("If an account exists for that address, we have sent a link to choose a new password. The link expires in 24 hours.", "إذا كان هناك حساب مرتبط بهذا البريد، فقد أرسلنا رابطاً لاختيار كلمة مرور جديدة. تنتهي صلاحية الرابط خلال 24 ساعة.")</p>
                <p class="text-muted small">@T("Nothing arrived? Check your junk folder, or contact the system administrator.", "لم تصلك الرسالة؟ تحقق من مجلد البريد غير الهام، أو تواصل مع مسؤول النظام.")</p>
                <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">@T("Back to sign in", "العودة إلى تسجيل الدخول")</a>
            </div>
        </div>
    </div>
</div>
