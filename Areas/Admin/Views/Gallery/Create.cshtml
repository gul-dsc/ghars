@model GharsPlatform.Controllers.Admin.GalleryController.AlbumVm
@using GharsPlatform.Models.Core
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    string L(string? en, string? arText) => ar ? (string.IsNullOrWhiteSpace(arText) ? en ?? "" : arText) : (en ?? arText ?? "");
    ViewData["Title"] = T("Create album", "إنشاء ألبوم");
    ViewData["PageTitle"] = ViewData["Title"];
    var seasons=ViewBag.Seasons as List<Season>??new();
    var orgs=ViewBag.Organizations as List<Organization>??new();
    var acts=ViewBag.Activities as List<Activity>??new();
}
<form method="post" enctype="multipart/form-data" class="card p-4 rounded-4 border-0 shadow-sm">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">@T("Title (English)", "العنوان بالإنجليزية")</label><input class="form-control" asp-for="TitleEn" /></div>
        <div class="col-md-6"><label class="form-label">@T("Title (Arabic)", "العنوان بالعربية")</label><input class="form-control" asp-for="TitleAr" /></div>
        <div class="col-md-6"><label class="form-label">@T("Description (English)", "الوصف بالإنجليزية")</label><textarea class="form-control" asp-for="DescriptionEn" rows="4"></textarea></div>
        <div class="col-md-6"><label class="form-label">@T("Description (Arabic)", "الوصف بالعربية")</label><textarea class="form-control" asp-for="DescriptionAr" rows="4"></textarea></div>
        <div class="col-md-3"><label class="form-label">@T("Season", "الموسم")</label><select class="form-select" asp-for="SeasonId"><option value="">@T("None", "بدون")</option>@foreach(var s in seasons){<option value="@s.Id">@L(s.TitleEn, s.TitleAr)</option>}</select></div>
        <div class="col-md-3"><label class="form-label">@T("Club / entity", "النادي / الجهة")</label><select class="form-select" asp-for="OrganizationId"><option value="">@T("General album", "ألبوم عام")</option>@foreach(var o in orgs){<option value="@o.Id">@L(o.NameEn, o.NameAr)</option>}</select></div>
        <div class="col-md-3"><label class="form-label">@T("Lecture / workshop / activity", "المحاضرة / الورشة / النشاط")</label><select class="form-select" asp-for="ActivityId"><option value="">@T("Not linked", "غير مرتبط")</option>@foreach(var a in acts){<option value="@a.Id">@L(a.TitleEn, a.TitleAr)</option>}</select></div>
        <div class="col-md-3"><label class="form-label">@T("Album date", "تاريخ الألبوم")</label><input type="date" class="form-control" asp-for="AlbumDate" /></div>
        <div class="col-md-6"><label class="form-label">@T("Cover image", "صورة الغلاف")</label><input type="file" class="form-control" asp-for="CoverImage" accept="image/*" /></div>
        <div class="col-md-6 d-flex align-items-end"><div class="form-check"><input class="form-check-input" asp-for="IsPublic" /><label class="form-check-label">@T("Show on site", "إظهار على الموقع")</label></div></div>
        <div class="col-12 d-flex gap-2"><button class="btn btn-primary">@T("Create album", "إنشاء الألبوم")</button><a class="btn btn-outline-secondary" asp-action="Index">@T("Cancel", "إلغاء")</a></div>
    </div>
</form>
