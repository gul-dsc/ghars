@model GharsPlatform.ViewModels.PartnerProgramVm
@using GharsPlatform.Models.Core
@using GharsPlatform.Helpers
@using System.Globalization
@{
 var ar=CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar"; string T(string e,string a)=>ar?a:e;
 var activity=ViewBag.Activity as Activity;
 var approval=activity?.ApprovalStatus;
 ViewData["Title"]=T("Edit Program","تعديل البرنامج");
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="mb-1">@T("Edit Program","تعديل البرنامج")</h1>
        <div class="text-muted">
            <span class="badge @OfferingWorkflow.BadgeClass(approval)">@OfferingWorkflow.Label(approval)</span>
        </div>
    </div>
    <a class="btn btn-outline-secondary" href="/partner/programs">@T("Back to My Programs","العودة إلى برامجي")</a>
</div>

@if(!string.IsNullOrWhiteSpace(activity?.ReviewNotes))
{
    <div class="alert alert-warning">
        <div class="fw-semibold mb-1">
            <i class="bi bi-chat-left-text me-1"></i>@T("Reviewer notes from DSC","ملاحظات المراجع من مجلس دبي الرياضي")
            @if(activity!.ReviewedAtUtc is not null){<span class="fw-normal text-muted small ms-2">@activity.ReviewedAtUtc.Value.ToString("yyyy-MM-dd")</span>}
        </div>
        <div>@activity!.ReviewNotes</div>
    </div>
}

<form method="post" action="/partner/programs/edit/@Model.Id">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="HasBookings" />
    @await Html.PartialAsync("_Form", Model)

    <div class="d-flex gap-2 mb-5">
        <button class="btn btn-primary" type="submit" name="action" value="save">@T("Save Changes","حفظ التعديلات")</button>
        <button class="btn btn-success" type="submit" name="action" value="submit">
            @(approval==OfferingApprovalStatus.Draft ? T("Save and Submit for Approval","حفظ وإرسال للاعتماد") : T("Save and Resubmit","حفظ وإعادة الإرسال"))
        </button>
        <a class="btn btn-outline-secondary" href="/partner/programs">@T("Cancel","إلغاء")</a>
    </div>
</form>
