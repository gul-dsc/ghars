@model GharsPlatform.Controllers.Admin.LibraryController.ItemVm
@{
    ViewData["Title"] = "Create Library Item";
    ViewData["PageTitle"] = "Create Library Item";
    var categories = ViewBag.Categories as List<GharsPlatform.Models.Core.LibraryCategory> ?? new();
}
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <form method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Category</label>
                    <select class="form-select" asp-for="LibraryCategoryId">
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id">@c.NameEn</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Points Cost</label>
                    <input class="form-control" asp-for="PointsCost" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Content Type</label>
                    <select class="form-select" asp-for="ContentType">
                        @foreach (GharsPlatform.Models.Core.LibraryContentType t in Enum.GetValues(typeof(GharsPlatform.Models.Core.LibraryContentType))) { <option value="@t">@t</option> }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Publishing Entity EN</label>
                    <input class="form-control" asp-for="PublishingEntityEn" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Publication Date</label>
                    <input class="form-control" type="date" asp-for="PublicationDate" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Visibility</label>
                    <div class="form-check mt-2"><input class="form-check-input" asp-for="IsPublic" /><label class="form-check-label">Public</label></div>
                    <div class="form-check"><input class="form-check-input" asp-for="IsPublished" /><label class="form-check-label">Published</label></div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Publishing Entity AR</label>
                    <input class="form-control" asp-for="PublishingEntityAr" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">External Publication / Video Link</label>
                    <input class="form-control" asp-for="ExternalUrl" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Title (EN)</label>
                    <input class="form-control" asp-for="TitleEn" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Title (AR)</label>
                    <input class="form-control" asp-for="TitleAr" />
                </div>

                <div class="col-12">
                    <label class="form-label">Description (EN)</label>
                    <textarea class="form-control" asp-for="DescriptionEn" rows="3"></textarea>
                </div>
                <div class="col-12">
                    <label class="form-label">Description (AR)</label>
                    <textarea class="form-control" asp-for="DescriptionAr" rows="3"></textarea>
                </div>

                <div class="col-12">
                    <label class="form-label">PDF File (preferred)</label>
                    <input class="form-control" type="file" asp-for="File" accept=".pdf,.mp4,.webm" />
                    <span class="text-danger small" asp-validation-for="File"></span>
                </div>
                <div class="col-12">
                    <label class="form-label">Cover Image (required if PDF is not available)</label>
                    <input class="form-control" type="file" asp-for="CoverImage" accept="image/*" />
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a class="btn btn-outline-secondary" href="/Admin/Library/Items">Back</a>
                <button class="btn btn-primary" type="submit">Create</button>
            </div>

            <div class="text-danger small mt-2" asp-validation-summary="All"></div>
        </form>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
