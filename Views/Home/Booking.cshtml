@model List<GharsPlatform.Models.Core.Organization>
@using GharsPlatform.Models.Core
@using System.Globalization
@using GharsPlatform.Models.Identity
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    string Name(Organization o) => ar && !string.IsNullOrWhiteSpace(o.NameAr) ? o.NameAr : o.NameEn;
    string Title(Activity x) => ar && !string.IsNullOrWhiteSpace(x.TitleAr) ? x.TitleAr : x.TitleEn;
    string? Desc(Activity x) => ar && !string.IsNullOrWhiteSpace(x.DescriptionAr) ? x.DescriptionAr : x.DescriptionEn;
    string TypeText(ActivityType t) => t == ActivityType.Workshop ? T("Workshop", "ورشة عمل") : T("Training", "تدريب");
    string AudienceText(string a) => a switch { "Players" => T("Players", "لاعبون"), "Coaches" => T("Coaches", "مدربون"), "Staff" => T("Staff", "موظفون"), "Administrators" => T("Administrators", "إداريون"), "Parents" => T("Parents", "أولياء أمور"), "Others" => T("Others", "أخرى"), _ => a };

    ViewData["Title"] = T("Booking", "الحجز");

    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var isClub = User.IsInRole(RoleNames.ClubAdmin);
    var isAdmin = User.IsInRole(RoleNames.SuperAdmin) || User.IsInRole(RoleNames.DscAdmin);
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    var offerings = ViewBag.Offerings as Dictionary<int, List<Activity>> ?? new();
    // Only entities that actually have something bookable appear in the catalogue filter. Every
    // eligible entity is still reachable through Request Custom Booking, which keeps its own list.
    var filterEntities = ViewBag.FilterEntities as List<Organization> ?? Model;
    var seasons = ViewBag.Seasons as List<Season> ?? new();
    var selectedEntity = ViewBag.EntityId as int?;
    var selectedType = ViewBag.Type as ActivityType?;
    var selectedSeason = ViewBag.SeasonId as int?;
    var query = ViewBag.Query as string;
    var total = (int)(ViewBag.TotalOfferings ?? 0);
    var byId = Model.ToDictionary(x => x.Id);

    string LogoOf(Organization o) => string.IsNullOrWhiteSpace(o.LogoPath)
        ? Url.Content("~/img/partners/default-partner.svg")
        : Url.Content(o.LogoPath);

    // The Custom Program Request entry point, used in three places: the choice card at the top of the
    // page, the secondary action beneath the catalogue, and the empty state. Its own route, so the
    // path a club took is unambiguous from the URL alone.
    var customHref = isClub ? "/bookings/custom" : null;
}

<div class="partner-hero mb-4">
    <h1 class="display-6 fw-bold mb-2">@T("Booking", "الحجز")</h1>
    <p class="mb-0 opacity-75">
        @T("There are two ways to book with a Ghars implementing entity: request one of their published programs, or ask for a program of your own.",
           "هناك طريقتان للحجز مع الجهات المنفذة في غرس: طلب أحد برامجها المنشورة، أو طلب برنامج خاص بكم.")
    </p>
</div>

@* The two booking paths, given equal weight. A custom request is not a fallback for a failed
   search — it is the second way in, and burying it at the bottom of the page said otherwise. *@
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100 border-0 shadow-sm rounded-4">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-collection fs-4 text-primary" aria-hidden="true"></i>
                    <h2 class="h5 mb-0">@T("Book an Existing Program", "حجز برنامج قائم")</h2>
                </div>
                <p class="text-muted small flex-grow-1 mb-3">
                    @T("Browse Training and Workshop programs already offered by Ghars implementing entities and request a booking.",
                       "تصفحوا برامج التدريب وورش العمل التي تقدمها الجهات المنفذة في غرس واطلبوا حجزها.")
                </p>
                <a class="btn btn-ghars" href="#programs">
                    <i class="bi bi-search me-1" aria-hidden="true"></i>@T("Browse Programs", "تصفح البرامج")
                    <span class="badge text-bg-light ms-1">@total</span>
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100 border-0 shadow-sm rounded-4">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-pencil-square fs-4 text-primary" aria-hidden="true"></i>
                    <h2 class="h5 mb-0">@T("Request a Custom Program", "طلب برنامج مخصص")</h2>
                </div>
                <p class="text-muted small flex-grow-1 mb-3">
                    @T("If the program you need is not listed, send a custom request directly to an implementing entity.",
                       "إذا لم يكن البرنامج الذي تحتاجونه مدرجاً، أرسلوا طلباً مخصصاً مباشرة إلى إحدى الجهات المنفذة.")
                </p>
                @if (isClub)
                {
                    <a class="btn btn-ghars" href="@customHref">
                        <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>@T("Request Custom Program", "طلب برنامج مخصص")
                    </a>
                }
                else if (!isAuthenticated)
                {
                    <a class="btn btn-outline-success"
                       asp-controller="Account" asp-action="Login" asp-route-returnUrl="/bookings/custom">
                        <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>@T("Sign in to request", "سجّل الدخول للطلب")
                    </a>
                }
                else
                {
                    @* An administrator has no club to book for; saying so beats a button that 403s. *@
                    <div class="small text-muted">@T("Available to club accounts.", "متاح لحسابات الأندية.")</div>
                }
            </div>
        </div>
    </div>
</div>

@if (!isAuthenticated)
{
    <div class="ghars-filter-empty mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <span>@T("Sign in with a club account to request any of the programs below.",
                 "سجّل الدخول بحساب نادٍ لتتمكن من طلب أي من البرامج أدناه.")</span>
        <a class="btn btn-ghars btn-sm" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">
            <i class="bi bi-box-arrow-in-right me-1"></i>@T("Sign in", "تسجيل الدخول")
        </a>
    </div>
}
else if (isAdmin)
{
    <div class="ghars-filter-empty mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <span>@T("You are signed in as an administrator. All booking requests are managed in the admin area.",
                 "أنت مسجّل الدخول كمسؤول. تتم إدارة جميع طلبات الحجز من منطقة الإدارة.")</span>
        <a class="btn btn-ghars btn-sm" asp-area="Admin" asp-controller="Bookings" asp-action="Index">
            <i class="bi bi-calendar-check me-1"></i>@T("Manage bookings", "إدارة الحجوزات")
        </a>
    </div>
}

<form method="get" class="ghars-filter-card row g-2 align-items-end mb-4">
    <div class="col-md-3">
        <label class="form-label" for="f-entity">@T("Implementing Entity", "الجهة المنفذة")</label>
        <select class="form-select" id="f-entity" name="entityId">
            <option value="">@T("All", "الكل")</option>
            @foreach (var e in filterEntities)
            {
                <option value="@e.Id" selected="@(selectedEntity == e.Id)">@Name(e)</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label" for="f-type">@T("Type", "النوع")</label>
        <select class="form-select" id="f-type" name="type">
            <option value="">@T("All", "الكل")</option>
            <option value="@ActivityType.TrainingProgram" selected="@(selectedType == ActivityType.TrainingProgram)">@T("Training", "تدريب")</option>
            <option value="@ActivityType.Workshop" selected="@(selectedType == ActivityType.Workshop)">@T("Workshop", "ورشة عمل")</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label" for="f-season">@T("Sports Season", "الموسم الرياضي")</label>
        <select class="form-select" id="f-season" name="seasonId">
            <option value="">@T("All", "الكل")</option>
            @foreach (var s in seasons)
            {
                <option value="@s.Id" selected="@(selectedSeason == s.Id)">@(ar ? s.TitleAr : s.TitleEn)</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label" for="f-q">@T("Search", "بحث")</label>
        <input class="form-control" id="f-q" name="q" value="@query" placeholder="@T("Program title", "عنوان البرنامج")" />
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button class="btn btn-primary">@T("Filter", "تصفية")</button>
        <a class="btn btn-outline-secondary" href="/Home/Booking">@T("Reset", "إعادة تعيين")</a>
    </div>
</form>

@* Anchor for the "Browse Programs" choice card above. *@
<h2 class="h4 mb-3" id="programs">
    @T("Existing Programs", "البرامج القائمة")
    <span class="text-muted fs-6">(@total)</span>
</h2>

@if (total == 0)
{
    <div class="empty-state mb-4">
        <div class="mb-3">@T("No programs match your filters right now.", "لا توجد برامج مطابقة لبحثكم حالياً.")</div>
        @if (isClub)
        {
            <div class="mb-3 small text-muted">@T("You can still describe what your club needs and send it to an implementing entity.",
                                                  "يمكنكم مع ذلك وصف ما يحتاجه ناديكم وإرساله إلى إحدى الجهات المنفذة.")</div>
            <a class="btn btn-ghars" href="@customHref"><i class="bi bi-pencil-square me-1" aria-hidden="true"></i>@T("Request Custom Program", "طلب برنامج مخصص")</a>
        }
        else if (!isAuthenticated)
        {
            <a class="btn btn-outline-success" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">
                <i class="bi bi-box-arrow-in-right me-1"></i>@T("Sign in to request", "سجّل الدخول للطلب")
            </a>
        }
    </div>
}
else
{
    @foreach (var group in offerings)
    {
        if (!byId.TryGetValue(group.Key, out var entity)) { continue; }

        <section class="mb-4">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="entity-logo-frame" style="width:64px;height:64px;flex:0 0 64px;">
                    <img src="@LogoOf(entity)" alt="@Name(entity)" loading="lazy" />
                </div>
                <div>
                    <h3 class="h5 mb-0">@Name(entity)</h3>
                    <div class="text-muted small">@group.Value.Count @T("program(s)", "برنامج")</div>
                </div>
            </div>

            <div class="row g-3">
                @foreach (var offering in group.Value)
                {
                    var audiences = string.IsNullOrWhiteSpace(offering.TargetAudienceCsv)
                        ? new List<string>()
                        : offering.TargetAudienceCsv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
                    var minutes = (int)(offering.EndDateTime - offering.StartDateTime).TotalMinutes;

                    <div class="col-md-6 col-xl-4">
                        <article class="card h-100 shadow-sm border-0 rounded-4">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <h4 class="h6 mb-0">@Title(offering)</h4>
                                    <span class="badge text-bg-primary flex-shrink-0">@TypeText(offering.Type)</span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(Desc(offering)))
                                {
                                    <p class="text-muted small mb-3">@(Desc(offering)!.Length > 180 ? Desc(offering)![..180] + "…" : Desc(offering))</p>
                                }

                                <ul class="list-unstyled small text-muted mb-3">
                                    @if (audiences.Count > 0)
                                    {
                                        <li><i class="bi bi-people me-1" aria-hidden="true"></i>@string.Join("، ", audiences.Select(AudienceText))</li>
                                    }
                                    @if (offering.Capacity > 0)
                                    {
                                        <li><i class="bi bi-person-badge me-1" aria-hidden="true"></i>@T($"Up to {offering.Capacity} participants", $"حتى {offering.Capacity} مشارك")</li>
                                    }
                                    @if (minutes > 0)
                                    {
                                        <li><i class="bi bi-clock me-1" aria-hidden="true"></i>@T($"{minutes} minutes", $"{minutes} دقيقة")</li>
                                    }
                                    @if (offering.Season is not null)
                                    {
                                        <li><i class="bi bi-calendar3 me-1" aria-hidden="true"></i>@(ar ? offering.Season.TitleAr : offering.Season.TitleEn)</li>
                                    }
                                    @if (offering.AvailableFromUtc is not null || offering.AvailableUntilUtc is not null)
                                    {
                                        @* Shown only when the partner set a window. An offering with no
                                           window is simply available, and saying so adds nothing. *@
                                        <li>
                                            <i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>
                                            @if (offering.AvailableFromUtc is not null && offering.AvailableUntilUtc is not null)
                                            {
                                                @T("Available", "متاح")<text> </text>@offering.AvailableFromUtc.Value.ToString("yyyy-MM-dd")<text> → </text>@offering.AvailableUntilUtc.Value.ToString("yyyy-MM-dd")
                                            }
                                            else if (offering.AvailableUntilUtc is not null)
                                            {
                                                @T("Available until", "متاح حتى")<text> </text>@offering.AvailableUntilUtc.Value.ToString("yyyy-MM-dd")
                                            }
                                            else
                                            {
                                                @T("Available from", "متاح من")<text> </text>@offering.AvailableFromUtc!.Value.ToString("yyyy-MM-dd")
                                            }
                                        </li>
                                    }
                                </ul>

                                <div class="mt-auto">
                                    @if (isClub)
                                    {
                                        <a class="btn btn-ghars w-100" href="/bookings/create?activityId=@offering.Id">
                                            <i class="bi bi-calendar-plus me-1"></i>@T("Request Booking", "طلب حجز")
                                        </a>
                                    }
                                    else if (!isAuthenticated)
                                    {
                                        @* Anonymous browsing is allowed; requesting is not. The intended
                                           destination is preserved so sign-in continues into this offering. *@
                                        <a class="btn btn-outline-success w-100"
                                           asp-controller="Account" asp-action="Login"
                                           asp-route-returnUrl="@($"/bookings/create?activityId={offering.Id}")">
                                            <i class="bi bi-box-arrow-in-right me-1"></i>@T("Sign in to request", "سجّل الدخول للطلب")
                                        </a>
                                    }
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        </section>
    }

    @* The same second path offered again at the point a club is most likely to conclude the
       catalogue has nothing for it — having scrolled the whole list. *@
    @if (isClub)
    {
        <div class="ghars-filter-empty d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <div class="fw-semibold">@T("Can't find what you need?", "لم تجدوا ما تحتاجونه؟")</div>
                <div class="small text-muted mb-0">@T("Request a specific program directly from an implementing entity.",
                                                      "اطلبوا برنامجاً محدداً مباشرة من إحدى الجهات المنفذة.")</div>
            </div>
            <a class="btn btn-outline-primary" href="@customHref">
                <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>@T("Request Custom Program", "طلب برنامج مخصص")
            </a>
        </div>
    }
}
