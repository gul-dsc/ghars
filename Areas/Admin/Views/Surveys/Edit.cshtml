@model GharsPlatform.Controllers.Admin.SurveysController.SurveyVm
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    ViewData["Title"] = T("Edit survey", "تعديل الاستبيان");
    ViewData["PageTitle"] = ViewData["Title"];
}

<h1 class="h4 mb-3">@ViewData["Title"]</h1>

<form method="post" class="card border-0 shadow-sm rounded-4 p-3 p-md-4">
    @Html.AntiForgeryToken()
    <partial name="_SurveyForm" model="Model" />

    <div class="d-flex justify-content-between align-items-center mt-4 flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">@T("Cancel", "إلغاء")</a>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" asp-action="Questions" asp-route-id="@Model.Id">@T("Manage questions", "إدارة الأسئلة")</a>
            <button class="btn btn-primary" type="submit"><i class="bi bi-check2 me-1"></i>@T("Save", "حفظ")</button>
        </div>
    </div>
</form>
