@model List<GharsPlatform.Models.Core.BookingRequest>
@{
    ViewData["Title"] = "Bookings Report";
    ViewData["PageTitle"] = "Bookings Report";
}
<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Organization</th>
                <th>Activity</th>
                <th>Seats</th>
                <th>Status</th>
                <th>Created</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.Id</td>
                    <td>@b.Organization?.NameEn</td>
                    <td>@b.Activity?.TitleEn</td>
                    <td>@b.RequestedSeats</td>
                    <td>@b.Status</td>
                    <td>@b.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
