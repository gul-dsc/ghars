@model List<GharsPlatform.Models.Core.NewsItem>
@{
    ViewData["Title"] = "News Ticker";
    ViewData["PageTitle"] = "News Ticker";
}
<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="fw-semibold">News Items</div>
    <a class="btn btn-sm btn-primary super-admin-action" href="/Admin/News/Create"><i class="bi bi-plus-lg"></i> Create</a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Active</th>
                <th>Priority</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var n in Model)
            {
                <tr>
                    <td>@n.Id</td>
                    <td class="fw-semibold">@n.TitleEn</td>
                    <td>@(n.IsActive ? "Yes" : "No")</td>
                    <td>@n.Priority</td>
                    <td class="text-end">
                        <form method="post" action="/Admin/News/Toggle/@n.Id">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-secondary" type="submit">Toggle</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
