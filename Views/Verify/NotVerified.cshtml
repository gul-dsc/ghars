@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    ViewData["Title"] = T("Certificate verification", "التحقق من الشهادة");
}
<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <h3 class="mb-3"><i class="bi bi-award me-2"></i>@T("Certificate verification", "التحقق من الشهادة")</h3>
                <div class="alert alert-warning mb-0">
                    <i class="bi bi-exclamation-triangle me-1"></i>@T("We couldn't verify this certificate. Check that the link or QR code is complete, or contact Dubai Sports Council.", "تعذّر التحقق من هذه الشهادة. تأكد من اكتمال الرابط أو رمز QR، أو تواصل مع مجلس دبي الرياضي.")
                </div>
                <div class="mt-4">
                    <a class="btn btn-primary" href="/">@T("Back to home", "العودة إلى الرئيسية")</a>
                </div>
            </div>
        </div>
    </div>
</div>
