@model GharsPlatform.Models.Core.Survey
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    ViewData["Title"] = T("Survey closed", "الاستبيان مغلق");
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="card shadow-sm border-0 rounded-4 text-center">
            <div class="card-body p-4 p-md-5">
                <img src="~/img/brand/ghars-logo.png" alt="@T("Ghars Program", "برنامج غرس")" style="height:64px;width:auto;" class="mb-4" />

                <div class="display-6 text-secondary mb-3" aria-hidden="true"><i class="bi bi-lock-fill"></i></div>

                <h1 class="h4 mb-2">@T("This survey is closed", "هذا الاستبيان مغلق")</h1>
                <p class="text-muted mb-1">@(ar ? Model.TitleAr : Model.TitleEn)</p>
                @if (Model.ClosesAtUtc.HasValue)
                {
                    <p class="text-muted small">@T("Closed on", "أُغلق بتاريخ") @Model.ClosesAtUtc.Value.ToString("yyyy-MM-dd")</p>
                }
                <p class="text-muted mb-4">@T("It is no longer accepting responses. Thank you for your interest.", "لم يعد يقبل استجابات. شكراً لاهتمامك.")</p>

                <a class="btn btn-outline-primary" href="~/">@T("Go to the Ghars home page", "الانتقال إلى الصفحة الرئيسية لغرس")</a>
            </div>
        </div>
    </div>
</div>
