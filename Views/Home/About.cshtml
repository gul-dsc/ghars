@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    ViewData["Title"] = T("About the Ghars Program", "حول برنامج غرس");
}
@* Approved wording from the "About the Ghars Program" business document (AR/EN), rendered from
   GharsProgramContent so the home and Vision pages always show the same text. *@
<div class="card mb-4"><div class="card-body p-4 p-md-5">
    <h1 class="section-title h3 mb-3">@T("About the “Ghars” Program", "حول برنامج \"غرس\"")</h1>

    @for (var i = 0; i < GharsProgramContent.Introduction.Count; i++)
    {
        var last = i == GharsProgramContent.Introduction.Count - 1;
        <p class="@(last ? "mb-0" : "mb-3")">@GharsProgramContent.Introduction[i].For(ar)</p>
    }
</div></div>

<div class="card mb-4"><div class="card-body p-4 p-md-5">
    <h2 class="section-title h4 mb-3"><i class="bi bi-people me-2"></i>@T("Scope of Application", "نطاق التطبيق")</h2>
    <p class="mb-3">@GharsProgramContent.Scope.For(ar)</p>
    <div class="d-flex flex-wrap gap-2">
        @foreach (var audience in GharsProgramContent.ScopeAudiences)
        {
            <span class="badge text-bg-light border p-2"><i class="bi @audience.Icon me-1"></i>@audience.Label.For(ar)</span>
        }
    </div>
</div></div>

<div class="card"><div class="card-body p-4 p-md-5">
    <h2 class="section-title h4 mb-4"><i class="bi bi-gear-wide-connected me-2"></i>@T("Implementation Mechanisms", "آليات التنفيذ")</h2>
    <div class="row g-4">
        @foreach (var mechanism in GharsProgramContent.Mechanisms)
        {
            <div class="col-md-4">
                <h3 class="h6 fw-bold"><i class="bi @mechanism.Icon me-2 text-success"></i>@mechanism.Title.For(ar)</h3>
                <p class="text-muted mb-0">@mechanism.Body.For(ar)</p>
            </div>
        }
    </div>
</div></div>
