@model GharsPlatform.Controllers.AccountController.RegisterVm
@{
    ViewData["Title"] = "Register";
}
<div class="row justify-content-center">
    <div class="col-md-7 col-xl-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <h3 class="mb-3">Create account</h3>
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input class="form-control" asp-for="FullName" />
                        <span class="text-danger small" asp-validation-for="FullName"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input class="form-control" asp-for="Email" />
                        <span class="text-danger small" asp-validation-for="Email"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Preferred Language</label>
                        <select class="form-select" asp-for="PreferredLanguage">
                            <option value="en">English</option>
                            <option value="ar">العربية</option>
                        </select>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Password</label>
                            <input class="form-control" asp-for="Password" type="password" />
                            <span class="text-danger small" asp-validation-for="Password"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Confirm Password</label>
                            <input class="form-control" asp-for="ConfirmPassword" type="password" />
                            <span class="text-danger small" asp-validation-for="ConfirmPassword"></span>
                        </div>
                    </div>
                    <button class="btn btn-primary w-100 mt-4" type="submit">Register</button>
                    <div class="text-danger small mt-3" asp-validation-summary="All"></div>
                </form>
                <div class="mt-3 small">
                    Already have an account? <a asp-action="Login">Sign in</a>.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
