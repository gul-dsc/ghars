@model List<GharsPlatform.Models.Core.NotificationDelivery>
@using GharsPlatform.Models.Core
@using System.Globalization
@{
    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string en,string ar)=>isAr?ar:en;
    ViewData["Title"] = T("Notifications", "الإشعارات");
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1 class="h3 mb-1">@T("Notifications", "الإشعارات")</h1><div class="text-muted">@T("Review all notifications and pending actions.", "مراجعة جميع الإشعارات والإجراءات المطلوبة.")</div></div>
    <form method="post" action="/notifications/read-all">@Html.AntiForgeryToken()<button class="btn btn-outline-success" type="submit"><i class="bi bi-check2-all me-1"></i>@T("Mark all as read", "تحديد الكل كمقروء")</button></form>
</div>
<form class="ghars-filter-card row g-2 align-items-end" method="get">
    <div class="col-md-3"><label class="form-label">@T("Read state", "حالة القراءة")</label><select class="form-select" name="state"><option value="">@T("All", "الكل")</option><option value="unread" selected="@(ViewBag.State=="unread")">@T("Unread", "غير مقروء")</option><option value="read" selected="@(ViewBag.State=="read")">@T("Read", "مقروء")</option></select></div>
    <div class="col-md-3"><label class="form-label">@T("Type", "النوع")</label><select class="form-select" name="type"><option value="">@T("All", "الكل")</option>@foreach(NotificationType t in Enum.GetValues(typeof(NotificationType))){<option value="@t" selected="@(ViewBag.Type==t)">@t</option>}</select></div>
    <div class="col-md-2"><label class="form-label">@T("From", "من")</label><input class="form-control" type="date" name="from" value="@ViewBag.From" /></div>
    <div class="col-md-2"><label class="form-label">@T("To", "إلى")</label><input class="form-control" type="date" name="to" value="@ViewBag.To" /></div>
    <div class="col-md-2"><button class="btn btn-primary w-100">@T("Filter", "تصفية")</button></div>
</form>
<div class="metric-card">
@if(Model.Count == 0){<div class="empty-state">@T("No notifications found.", "لا توجد إشعارات.")</div>}
else{
    <div class="list-group list-group-flush">
    @foreach(var d in Model){var n=d.Notification!;<a class="list-group-item list-group-item-action py-3 @(d.ReadAtUtc==null?"bg-light":"")" href="/notifications/open/@d.Id"><div class="d-flex justify-content-between gap-3"><div><div class="fw-semibold">@(isAr?n.TitleAr:n.TitleEn)</div><div class="text-muted">@(isAr?n.MessageAr:n.MessageEn)</div><div class="small text-muted mt-1">@n.CreatedAtUtc.ToString("g") · @n.Type</div></div><div>@if(d.ReadAtUtc==null){<span class="badge text-bg-warning">@T("Unread / action", "غير مقروء / إجراء")</span>}else{<span class="badge text-bg-secondary">@T("Read", "مقروء")</span>}</div></div></a>}
    </div>
}
</div>
