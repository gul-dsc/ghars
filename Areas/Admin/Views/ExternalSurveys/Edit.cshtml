@model GharsPlatform.Controllers.Admin.ExternalSurveysController.ExternalSurveyVm
@using GharsPlatform.Models.Core
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? T("Edit Official Survey", "تعديل الاستبيان الرسمي") : T("Add Official Survey", "إضافة استبيان رسمي");
    ViewData["PageTitle"] = ViewData["Title"];
    var seasons = ViewBag.Seasons as List<Season> ?? new();
    var existingReport = ViewBag.ExistingReport as string;
}
<form method="post" enctype="multipart/form-data" class="card p-4 rounded-4 border-0 shadow-sm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">@T("Title (English)", "العنوان بالإنجليزية")</label><input class="form-control" asp-for="TitleEn" /><span asp-validation-for="TitleEn" class="text-danger"></span></div>
        <div class="col-md-6"><label class="form-label">@T("Title (Arabic)", "العنوان بالعربية")</label><input class="form-control" asp-for="TitleAr" /><span asp-validation-for="TitleAr" class="text-danger"></span></div>
        <div class="col-md-6"><label class="form-label">@T("Description (English)", "الوصف بالإنجليزية")</label><textarea class="form-control" asp-for="DescriptionEn" rows="3"></textarea></div>
        <div class="col-md-6"><label class="form-label">@T("Description (Arabic)", "الوصف بالعربية")</label><textarea class="form-control" asp-for="DescriptionAr" rows="3"></textarea></div>

        <div class="col-12">
            <label class="form-label">@T("Official survey link (Dubai Digital Authority)", "رابط الاستبيان الرسمي (هيئة دبي الرقمية)")</label>
            <input class="form-control" asp-for="ExternalUrl" placeholder="https://..." />
            <div class="form-text">@T("Only http/https links are accepted.", "يتم قبول روابط http أو https فقط.")</div>
            <span asp-validation-for="ExternalUrl" class="text-danger"></span>
        </div>

        <div class="col-md-4"><label class="form-label">@T("Season", "الموسم")</label><select class="form-select" asp-for="SeasonId"><option value="">@T("Not linked", "غير مرتبط")</option>@foreach (var s in seasons){<option value="@s.Id">@(ar?s.TitleAr:s.TitleEn)</option>}</select></div>
        <div class="col-md-4"><label class="form-label">@T("Available from", "متاح من")</label><input class="form-control" type="datetime-local" asp-for="StartsAtUtc" /></div>
        <div class="col-md-4"><label class="form-label">@T("Available until", "متاح حتى")</label><input class="form-control" type="datetime-local" asp-for="EndsAtUtc" /><span asp-validation-for="EndsAtUtc" class="text-danger"></span></div>

        <div class="col-12"><hr /><h2 class="h6 mb-1">@T("Analysis report", "التقرير التحليلي")</h2><div class="text-muted small mb-2">@T("Upload the analyzed results report (PDF) received from the Dubai Digital Authority.", "ارفع تقرير النتائج التحليلي (PDF) الوارد من هيئة دبي الرقمية.")</div></div>
        <div class="col-md-6">
            <label class="form-label">@T("Report PDF", "ملف التقرير PDF")</label>
            <input class="form-control" type="file" asp-for="ReportPdf" accept=".pdf,application/pdf" />
            @if (!string.IsNullOrWhiteSpace(existingReport))
            {
                <div class="form-text">@T("Current report:", "التقرير الحالي:") <a href="@existingReport" target="_blank" rel="noopener noreferrer">PDF</a></div>
            }
            <span asp-validation-for="ReportPdf" class="text-danger"></span>
        </div>
        <div class="col-md-6 d-flex align-items-end">
            <div>
                <div class="form-check"><input class="form-check-input" asp-for="IsActive" /><label class="form-check-label">@T("Survey active / visible to club users", "الاستبيان نشط / ظاهر لمستخدمي الأندية")</label></div>
                <div class="form-check"><input class="form-check-input" asp-for="IsReportPublished" /><label class="form-check-label">@T("Publish the report alongside the survey", "نشر التقرير مع الاستبيان")</label></div>
            </div>
        </div>

        <div class="col-12 d-flex gap-2">
            <button class="btn btn-primary">@(isEdit ? T("Save changes", "حفظ التعديلات") : T("Add survey", "إضافة الاستبيان"))</button>
            <a class="btn btn-outline-secondary" asp-action="Index">@T("Cancel", "إلغاء")</a>
        </div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
