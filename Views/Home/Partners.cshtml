@model List<GharsPlatform.Models.Core.PartnerProfile>
@using System.Globalization
@{
    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string en, string ar) => isAr ? ar : en;
    string Name(GharsPlatform.Models.Core.Organization? o) => o == null ? "" : (isAr && !string.IsNullOrWhiteSpace(o.NameAr) ? o.NameAr : o.NameEn);
    string Desc(GharsPlatform.Models.Core.PartnerProfile p) => isAr && !string.IsNullOrWhiteSpace(p.OverviewAr) ? p.OverviewAr! : (p.OverviewEn ?? "");
    ViewData["Title"] = T("Partners", "الشركاء");
}
@section Head{
<style>
.partner-hero{background:linear-gradient(135deg,#1b5e32,#51b499);border-radius:24px;color:#fff;padding:34px;margin-bottom:24px;box-shadow:0 18px 45px rgba(27,94,50,.18)}
.partner-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.partner-card{border:1px solid #e4ebe8;border-radius:22px;background:#fff;padding:22px;min-height:260px;box-shadow:0 14px 38px rgba(53,53,53,.08);display:flex;flex-direction:column;gap:14px}.partner-logo{width:82px;height:82px;border-radius:20px;background:#f3faf7;border:1px solid #dceee7;object-fit:contain;padding:10px}.partner-title{font-weight:800;font-size:1.12rem;color:#25312e}.partner-desc{color:#64706c;line-height:1.6;min-height:52px}.partner-actions{margin-top:auto;display:flex;gap:10px;flex-wrap:wrap}.btn-ghars{background:#2d9b6c;color:#fff;border-color:#2d9b6c}.btn-ghars:hover{background:#1b5e32;color:#fff;border-color:#1b5e32}@@media(max-width:991px){.partner-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@@media(max-width:575px){.partner-grid{grid-template-columns:1fr}.partner-hero{padding:24px}}
</style>
}
<div class="partner-hero">
    <h1 class="display-6 fw-bold mb-2">@T("Ghars Partners", "شركاء غرس")</h1>
    <p class="mb-0 opacity-75">@T("Explore Dubai partners, their profiles, and available learning programs.", "استعرض شركاء دبي وملفاتهم والبرامج التعليمية المتاحة لديهم.")</p>
</div>
@if (Model.Count == 0)
{
    <div class="empty-state">@T("No partners are currently published.", "لا يوجد شركاء منشورون حالياً.")</div>
}
else
{
    <div class="partner-grid">
        @foreach (var item in Model)
        {
            var org = item.Organization;
            var logo = string.IsNullOrWhiteSpace(org?.LogoPath) ? Url.Content("~/img/partners/default-partner.svg") : Url.Content(org!.LogoPath);
            <article class="partner-card">
                <div class="d-flex align-items-center gap-3">
                    <img class="partner-logo" src="@logo" alt="@Name(org)" />
                    <div>
                        <div class="partner-title">@Name(org)</div>
                        <div class="text-muted small">@(org?.Email)</div>
                    </div>
                </div>
                <p class="partner-desc mb-0">@(!string.IsNullOrWhiteSpace(Desc(item)) ? Desc(item) : T("Strategic Ghars learning and youth development partner.", "شريك استراتيجي في برامج غرس للتعلم وتنمية الشباب."))</p>
                <div class="partner-actions">
                    <a class="btn btn-outline-success" href="/partners/@org!.Id"><i class="bi bi-info-circle me-1"></i>@T("Details", "التفاصيل")</a>
                    <a class="btn btn-ghars" href="/partners/@org.Id/learning-programs"><i class="bi bi-mortarboard me-1"></i>@T("Learning Programs", "البرامج التعليمية")</a>
                </div>
            </article>
        }
    </div>
}
