@model List<GharsPlatform.Controllers.Admin.UsersController.UserRowVm>
@{
    ViewData["Title"] = "Users";
    ViewData["PageTitle"] = "Users";
}
<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="fw-semibold">Users</div>
    <div class="d-flex flex-wrap gap-2">
        @if (User.IsInRole("Super Admin"))
        {
            <form id="bulkSend" method="post" asp-area="Admin" asp-controller="Users" asp-action="SendCredentialsBulk" class="d-inline"
                  data-confirm="Send login details to the selected users? Each one gets a NEW password by email and their current password stops working.">
                @Html.AntiForgeryToken()
                <button class="btn btn-sm btn-outline-success" type="submit"><i class="bi bi-envelope"></i> Email login details to selected</button>
            </form>
            <a class="btn btn-sm btn-primary super-admin-action" asp-area="Admin" asp-controller="Users" asp-action="Create"><i class="bi bi-plus-lg"></i> Create User</a>
        }
    </div>
</div>
@{ var placeholders = ViewBag.PlaceholderEmails as List<string> ?? new(); }
@if (placeholders.Count > 0 && User.IsInRole("Super Admin"))
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div><strong>@placeholders.Count placeholder organization accounts</strong> (club-… / partner-…) were created before the real users were nominated.</div>
        <form method="post" asp-area="Admin" asp-controller="Users" asp-action="RemovePlaceholderAccounts" class="d-inline"
              data-confirm="Delete these @placeholders.Count placeholder accounts? @string.Join(", ", placeholders.Take(40))@(placeholders.Count > 40 ? " …" : ""). Real users, admins and democlub/demoentity are kept." data-confirm-ok="Delete them">
            @Html.AntiForgeryToken()
            <button class="btn btn-sm btn-danger" type="submit"><i class="bi bi-trash"></i> Remove placeholder accounts</button>
        </form>
    </div>
}
<div class="small text-muted mb-2">Emailing login details sets a new random password for that user and sends it with their username. Test (.local) and deactivated accounts are skipped.</div>
<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th><input type="checkbox" class="form-check-input" aria-label="Select all" onclick="document.querySelectorAll('.user-pick').forEach(c => c.checked = this.checked)" /></th><th>Name</th><th>Email</th><th>Roles</th><th>Status</th><th>Login details</th><th></th></tr></thead>
            <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td><input type="checkbox" class="form-check-input user-pick" name="ids" value="@u.Id" form="bulkSend" aria-label="Select @u.Email" /></td>
                    <td class="fw-semibold">@u.FullName</td>
                    <td>@u.Email</td>
                    <td>@u.Roles</td>
                    <td><span class="badge text-bg-@(u.IsLocked ? "danger" : "success")">@(u.IsLocked ? "Inactive" : "Active")</span></td>
                    <td class="small">
                        @if (u.LoginSentAtUtc is DateTime sentUtc)
                        {
                            // Shown in UAE time (UTC+4, no daylight saving).
                            var sentLocal = sentUtc.AddHours(4);
                            <span class="badge text-bg-success-subtle text-success-emphasis border border-success-subtle" title="@(u.LoginSentBy != null ? "Sent by " + u.LoginSentBy : "")">
                                <i class="bi bi-envelope-check"></i> Sent
                            </span>
                            <div class="text-muted mt-1">@sentLocal.ToString("dd MMM yyyy, HH:mm")@(u.LoginSentCount > 1 ? $" · {u.LoginSentCount} times" : "")</div>
                        }
                        else
                        {
                            <span class="badge text-bg-light text-secondary border">Not sent</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (User.IsInRole("Super Admin"))
                        {
                            <form method="post" asp-area="Admin" asp-controller="Users" asp-action="SendCredentials" asp-route-id="@u.Id" class="d-inline"
                                  data-confirm="@(u.LoginSentAtUtc is DateTime prev ? $"Login details were already sent to {u.Email} on {prev.AddHours(4):dd MMM yyyy, HH:mm}. Send again? " : $"Email login details to {u.Email}? ")A new password is set and the current one stops working.">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-success" type="submit" title="Email login details"><i class="bi bi-envelope"></i> Send login</button>
                            </form>
                            <a class="btn btn-sm btn-outline-primary" asp-area="Admin" asp-controller="Users" asp-action="Edit" asp-route-id="@u.Id">Edit</a>
                            <form method="post" asp-area="Admin" asp-controller="Users" asp-action="Deactivate" asp-route-id="@u.Id" class="d-inline" data-confirm="Deactivate @u.Email? They will no longer be able to sign in." data-confirm-ok="Deactivate">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-warning" type="submit">Deactivate</button>
                            </form>
                        }
                        @if (User.IsInRole("Super Admin"))
                        {
                            <form method="post" asp-area="Admin" asp-controller="Users" asp-action="Delete" asp-route-id="@u.Id" class="d-inline" data-confirm="Delete this user?">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
