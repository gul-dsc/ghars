@model List<GharsPlatform.Models.Core.AttendanceSession>
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    ViewData["Title"] = T("Attendance report", "تقرير الحضور");
    ViewData["PageTitle"] = ViewData["Title"];
}
<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>@T("Session", "الجلسة")</th>
                <th>@T("Activity", "النشاط")</th>
                <th>@T("Start", "البداية")</th>
                <th>@T("End", "النهاية")</th>
                <th>@T("Attendees", "الحضور")</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Id</td>
                    <td class="fw-semibold">@(ar ? (string.IsNullOrWhiteSpace(s.Activity?.TitleAr) ? s.Activity?.TitleEn : s.Activity?.TitleAr) : s.Activity?.TitleEn)</td>
                    <td>@s.SessionStartUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@(s.SessionEndUtc?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                    <td>@(s.AttendanceRecords?.Count ?? 0)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
