@model GharsPlatform.Controllers.AccountController.LoginVm
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    ViewData["Title"] = T("Sign in", "تسجيل الدخول");
}
@* The form has no action attribute, so it posts back to the current URL including its query string.
   That is what carries ?returnUrl= through to the POST — for example when a visitor is sent here from
   the Booking page. *@
<div class="row justify-content-center">
    <div class="col-md-6 col-xl-5">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <h3 class="mb-3">@T("Sign in", "تسجيل الدخول")</h3>
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">@T("Email", "البريد الإلكتروني")</label>
                        <input class="form-control" asp-for="Email" autocomplete="username" />
                        <span class="text-danger small" asp-validation-for="Email"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@T("Password", "كلمة المرور")</label>
                        <input class="form-control" asp-for="Password" type="password" autocomplete="current-password" />
                        <span class="text-danger small" asp-validation-for="Password"></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="RememberMe" />
                            <label class="form-check-label">@T("Remember me", "تذكرني")</label>
                        </div>
                        <a class="small" asp-controller="Account" asp-action="ForgotPassword">@T("Forgot password?", "نسيت كلمة المرور؟")</a>
                    </div>
                    <button class="btn btn-primary w-100" type="submit">@T("Sign in", "تسجيل الدخول")</button>
                    <div class="text-danger small mt-3" asp-validation-summary="All"></div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
