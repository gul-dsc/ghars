@model List<GharsPlatform.Models.Core.LibraryItem>
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    string L(string? en, string? arText) => ar ? (string.IsNullOrWhiteSpace(arText) ? en ?? "" : arText) : (en ?? arText ?? "");
    ViewData["Title"] = T("Digital Library items", "إصدارات المكتبة الرقمية");
    ViewData["PageTitle"] = ViewData["Title"];
}
<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="fw-semibold">@T("Digital Library items", "إصدارات المكتبة الرقمية")</div>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-secondary" href="/Admin/Library/Categories">@T("Categories", "التصنيفات")</a>
        <a class="btn btn-sm btn-primary super-admin-action" href="/Admin/Library/CreateItem"><i class="bi bi-plus-lg"></i> @T("Add item", "إضافة إصدار")</a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>@T("ID", "الرقم")</th>
                <th>@T("Title", "العنوان")</th>
                <th>@T("Category", "التصنيف")</th>
                @* Rewards are disabled, so the points column is not shown. *@
                <th>@T("Visible without sign-in", "متاح دون تسجيل الدخول")</th>
                <th>@T("Downloads", "مرات التنزيل")</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td>@i.Id</td>
                    <td class="fw-semibold">@L(i.TitleEn, i.TitleAr)</td>
                    <td>@L(i.LibraryCategory?.NameEn, i.LibraryCategory?.NameAr)</td>
                    <td>@(i.IsPublic ? T("Yes", "نعم") : T("No", "لا"))</td>
                    <td>@i.DownloadCount</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3"><a class="btn btn-primary super-admin-action" href="/Admin/Library/CreateItem"><i class="bi bi-plus-lg"></i> @(Model.Any() ? T("Add item", "إضافة إصدار") : T("Add the first item", "إضافة الإصدار الأول"))</a></div>
