@model List<GharsPlatform.Models.Core.BookingRequest>
@using GharsPlatform.Helpers
@{
    var ar = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    ViewData["Title"] = T("Booking requests", "طلبات الحجز");
    ViewData["PageTitle"] = T("Booking requests", "طلبات الحجز");
    string OrgName(Organization? o) => o is null ? "—" : (ar && !string.IsNullOrWhiteSpace(o.NameAr) ? o.NameAr : o.NameEn);
    var status = ViewBag.Status as string;
    var source = ViewBag.Source as BookingSourceFilter?;
    // Preserved across the two filter rows so choosing a source does not silently clear the status.
    string Q(string? s, BookingSourceFilter? src)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(s)) parts.Add("status=" + s);
        if (src.HasValue) parts.Add("source=" + src.Value);
        return parts.Count == 0 ? "/Admin/Bookings" : "/Admin/Bookings?" + string.Join("&", parts);
    }
    string Active(bool on) => on ? "btn-secondary" : "btn-outline-secondary";
}
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <div class="fw-semibold">@T("Booking requests", "طلبات الحجز") <span class="text-muted">(@Model.Count)</span></div>
    <div class="d-flex gap-2 flex-wrap">
        @foreach (var st in BookingStatusText.Distinct)
        {
            var key = st.ToString();
            var on = Enum.TryParse<BookingStatus>(status ?? "", out var cur) && cur == st;
            <a class="btn btn-sm @Active(on)" href="@Q(key, source)">@BookingStatusText.Label(st)</a>
        }
        <a class="btn btn-sm @Active(string.IsNullOrWhiteSpace(status))" href="@Q(null, source)">@T("All statuses", "كل الحالات")</a>
    </div>
</div>

@* Booking Source filter. Both paths stay in this one list — DSC sees every request either way. *@
<div class="d-flex align-items-center gap-2 flex-wrap mb-3">
    <span class="text-muted small">@T("Booking source:", "مصدر الحجز:")</span>
    <a class="btn btn-sm @Active(source is null)" href="@Q(status, null)">@T("All", "الكل")</a>
    <a class="btn btn-sm @Active(source == BookingSourceFilter.ExistingProgram)" href="@Q(status, BookingSourceFilter.ExistingProgram)">
        <i class="bi bi-collection me-1" aria-hidden="true"></i>@T("Existing program", "برنامج قائم")
    </a>
    <a class="btn btn-sm @Active(source == BookingSourceFilter.CustomProgram)" href="@Q(status, BookingSourceFilter.CustomProgram)">
        <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>@T("Custom program", "برنامج مخصص")
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>@T("ID", "الرقم")</th>
                <th>@T("Club", "النادي")</th>
                <th>@T("Program", "البرنامج")</th>
                <th>@T("Booking source", "مصدر الحجز")</th>
                <th>@T("Implementing entity", "الجهة المنفذة")</th>
                <th>@T("Seats", "المقاعد")</th>
                <th>@T("Status", "الحالة")</th>
                <th>@T("Created", "تاريخ الإنشاء")</th>
                <th><span class="visually-hidden">@T("Actions", "الإجراءات")</span></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.Id</td>
                    <td class="fw-semibold">@OrgName(b.Organization)</td>
                    @* Never b.Activity?.TitleEn alone: a custom request has no Activity and would
                       show an empty cell where the requested program name belongs. *@
                    <td>@BookingSource.Title(b)</td>
                    <td>
                        <span class="badge rounded-pill @BookingSource.BadgeClass(b)">
                            <i class="bi @BookingSource.Icon(b) me-1" aria-hidden="true"></i>@BookingSource.Label(b)
                        </span>
                    </td>
                    <td>@OrgName(b.PartnerOrganization)</td>
                    <td>@b.RequestedSeats</td>
                    <td><span class="badge @BookingStatusText.BadgeClass(b.Status)">@BookingStatusText.Label(b.Status)</span></td>
                    <td>@b.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-primary" href="/Admin/Bookings/Details/@b.Id">@T("Details", "التفاصيل")</a>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="9" class="text-muted p-3">@T("No booking requests match this filter.", "لا توجد طلبات حجز مطابقة لهذه التصفية.")</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
