@model GharsPlatform.Models.Core.GalleryItem
@using GharsPlatform.Helpers
@using GharsPlatform.Models.Core
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    var history = ViewBag.History as List<OfferingHistoryEntry> ?? new();
    var title = ar ? Model.TitleAr : Model.TitleEn;
    var desc = ar ? Model.DescriptionAr : Model.DescriptionEn;
    // The owning entity may preview its own content whatever its state; the endpoint enforces that.
    var src = !string.IsNullOrWhiteSpace(Model.FilePath) ? $"/protected-files/gallery/{Model.Id}" : Model.ExternalUrl;
    ViewData["Title"] = title;
}

<nav aria-label="@T("Breadcrumb", "مسار التنقل")">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">@T("My Ghars Channel Content", "محتواي في قناة غرس")</a></li>
        <li class="breadcrumb-item active" aria-current="page">@title</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">@title</h1>
        <div class="text-muted">
            @ChannelWorkflow.CategoryLabel(Model.ChannelCategory ?? ChannelCategory.Awareness)
            <span class="mx-1">·</span>@Model.MediaDate.ToString("yyyy-MM-dd")
            <span class="mx-1">·</span>@(ar ? Model.Season?.TitleAr : Model.Season?.TitleEn)
        </div>
    </div>
    <span class="badge @ChannelWorkflow.StatusBadgeClass(Model.ApprovalStatus)">
        <i class="bi @ChannelWorkflow.StatusIcon(Model.ApprovalStatus) me-1" aria-hidden="true"></i>@ChannelWorkflow.StatusLabel(Model.ApprovalStatus)
    </span>
</div>

<div class="alert alert-light border d-flex gap-2">
    <i class="bi bi-info-circle flex-shrink-0" aria-hidden="true"></i>
    <div>@ChannelWorkflow.Explain(Model.ApprovalStatus)</div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ReviewNotes))
{
    <div class="alert alert-warning">
        <h2 class="h6"><i class="bi bi-chat-left-text me-1" aria-hidden="true"></i>@T("Reviewer's notes", "ملاحظات المراجع")</h2>
        <p class="mb-0">@Model.ReviewNotes</p>
    </div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card rounded-4 border-0 shadow-sm">
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.FilePath))
                {
                    if (ChannelWorkflow.IsVideo(Model))
                    {
                        <video src="@src" controls class="w-100 rounded" style="max-height:60vh;background:#000">
                            @T("Your browser cannot play this video.", "متصفحكم لا يدعم تشغيل هذا الفيديو.")
                        </video>
                    }
                    else
                    {
                        <img src="@src" alt="@title" class="w-100 rounded" style="max-height:60vh;object-fit:contain" />
                    }
                }
                else if (!string.IsNullOrWhiteSpace(Model.ExternalUrl))
                {
                    <p class="mb-2">@T("External link", "رابط خارجي"):</p>
                    <a href="@Model.ExternalUrl" target="_blank" rel="noopener noreferrer" dir="ltr">@Model.ExternalUrl</a>
                }
                else if (Model.LibraryItem is not null)
                {
                    <p class="mb-2">@T("Linked Digital Library publication", "إصدار مرتبط في المكتبة الرقمية"):</p>
                    <a class="btn btn-outline-success" asp-controller="Library" asp-action="Index">
                        <i class="bi bi-journal-text me-1" aria-hidden="true"></i>@(ar ? Model.LibraryItem.TitleAr : Model.LibraryItem.TitleEn)
                    </a>
                }

                @if (!string.IsNullOrWhiteSpace(desc))
                {
                    <p class="mt-3 mb-0">@desc</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card rounded-4 border-0 shadow-sm mb-3">
            <div class="card-body d-flex flex-wrap gap-2">
                @if (ChannelWorkflow.PartnerCanEdit(Model.ApprovalStatus))
                {
                    <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@Model.Id">@T("Edit", "تعديل")</a>
                }
                @if (ChannelWorkflow.PartnerCanSubmit(Model.ApprovalStatus))
                {
                    <form method="post" asp-action="Submit" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-success btn-sm" type="submit">@T("Submit for approval", "إرسال للاعتماد")</button>
                    </form>
                }
                @if (ChannelWorkflow.PartnerCanWithdraw(Model.ApprovalStatus))
                {
                    <form method="post" asp-action="Withdraw" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-outline-danger btn-sm" type="submit">@T("Withdraw", "سحب")</button>
                    </form>
                }
            </div>
        </div>

        <div class="card rounded-4 border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-3"><h2 class="h6 mb-0">@T("History", "السجل")</h2></div>
            <ul class="list-group list-group-flush small">
                @foreach (var h in history)
                {
                    var label = ChannelWorkflow.AuditActionLabel(h.Action);
                    if (label is null) { continue; }
                    <li class="list-group-item d-flex justify-content-between gap-2">
                        <span>@label</span><span class="text-muted">@h.AtUtc.ToString("yyyy-MM-dd HH:mm")</span>
                    </li>
                }
                @if (!history.Any(h => ChannelWorkflow.AuditActionLabel(h.Action) is not null))
                {
                    <li class="list-group-item text-muted">@T("No recorded activity yet.", "لا يوجد سجل بعد.")</li>
                }
            </ul>
        </div>
    </div>
</div>
