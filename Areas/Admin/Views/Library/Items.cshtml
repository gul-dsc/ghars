@model List<GharsPlatform.Models.Core.LibraryItem>
@{
    ViewData["Title"] = "Library Items";
    ViewData["PageTitle"] = "Library Items";
}
<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="fw-semibold">Library Items</div>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-secondary" href="/Admin/Library/Categories">Categories</a>
        <a class="btn btn-sm btn-primary super-admin-action" href="/Admin/Library/CreateItem"><i class="bi bi-plus-lg"></i> Create Item</a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Category</th>
                <th>Points</th>
                <th>Public</th>
                <th>Downloads</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td>@i.Id</td>
                    <td class="fw-semibold">@i.TitleEn</td>
                    <td>@i.LibraryCategory?.NameEn</td>
                    <td>@i.PointsCost</td>
                    <td>@(i.IsPublic ? "Yes" : "No")</td>
                    <td>@i.DownloadCount</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3"><a class="btn btn-primary super-admin-action" href="/Admin/Library/CreateItem"><i class="bi bi-plus-lg"></i> Create first library item</a></div>
