@model GharsPlatform.Models.Core.LibraryItem

@{
    var extension = System.IO.Path.GetExtension(Model.FilePath ?? string.Empty).ToLowerInvariant();
    var isPdf = extension == ".pdf";
    var isVideo = extension == ".mp4" || extension == ".webm" || extension == ".ogg";
}

<div class="modal-header">
    <div>
        <h5 class="modal-title mb-1">@Model.TitleEn</h5>
        <div class="text-muted small">
            @(Model.LibraryCategory?.NameEn ?? "Library Item")
        </div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    @if (!string.IsNullOrWhiteSpace(Model.DescriptionEn))
    {
        <p class="text-muted">@Model.DescriptionEn</p>
    }

    @if (isPdf)
    {
        <div class="ratio" style="--bs-aspect-ratio: 75%;">
            <iframe src="@Url.Action("Stream", "Library", new { id = Model.Id })#toolbar=1&navpanes=0&scrollbar=1"
                    width="100%"
                    height="100%"
                    style="border: 1px solid #ddd; border-radius: 10px;"
                    title="@Model.TitleEn">
            </iframe>
        </div>
    }
    else if (isVideo)
    {
        <video class="w-100 rounded"
               controls
               controlsList="nodownload noplaybackrate"
               disablePictureInPicture
               oncontextmenu="return false;">
            <source src="@Url.Action("Stream", "Library", new { id = Model.Id })" type="video/mp4" />
            Your browser does not support the video tag.
        </video>
    }
    else
    {
        <div class="alert alert-warning mb-0">
            Preview is not available for this file type.
        </div>
    }
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>