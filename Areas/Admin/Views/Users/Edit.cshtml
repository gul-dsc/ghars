@model GharsPlatform.Controllers.Admin.UsersController.UserEditVm
@using System.Globalization
@using GharsPlatform.Controllers.Admin
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    ViewData["Title"] = T("Edit user", "تعديل المستخدم");
    ViewData["PageTitle"] = T("Edit user", "تعديل المستخدم");
    var roles = ViewBag.Roles as List<string> ?? new();
    var orgs = ViewBag.Organizations as List<GharsPlatform.Models.Core.Organization> ?? new();
}
<div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4">
<form method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger small"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">@T("Full name", "الاسم الكامل")</label><input class="form-control" asp-for="FullName" /></div>
        <div class="col-md-6"><label class="form-label">@T("Email", "البريد الإلكتروني")</label><input class="form-control" asp-for="Email" dir="ltr" /></div>
        <div class="col-md-6"><label class="form-label">@T("New password (leave blank to keep the current one)", "كلمة مرور جديدة (اتركوها فارغة للإبقاء على الحالية)")</label><input class="form-control" asp-for="Password" type="password" /></div>
        <div class="col-md-6"><label class="form-label">@T("Role", "الدور")</label><select class="form-select" asp-for="RoleName">@foreach (var r in roles){<option value="@r">@OrganizationText.RoleLabel(r)</option>}</select></div>
        <div class="col-md-6"><label class="form-label">@T("Organization", "الجهة")</label><select class="form-select" asp-for="PrimaryOrganizationId"><option value="">@T("None", "بدون")</option>@foreach (var o in orgs){<option value="@o.Id">@(ar && !string.IsNullOrWhiteSpace(o.NameAr) ? o.NameAr : o.NameEn) (@OrganizationText.TypeLabel(o.OrganizationType))</option>}</select></div>
        <div class="col-md-3"><label class="form-label">@T("Language", "اللغة")</label><select class="form-select" asp-for="PreferredLanguage"><option value="en">English</option><option value="ar">العربية</option></select></div>
        <div class="col-md-3 d-flex align-items-end"><div class="form-check"><input class="form-check-input" asp-for="IsActive" /><label class="form-check-label" asp-for="IsActive">@T("Active", "نشط")</label></div></div>
    </div>
    <div class="mt-4"><button class="btn btn-primary" type="submit">@T("Save", "حفظ")</button><a class="btn btn-outline-secondary" asp-action="Index">@T("Cancel", "إلغاء")</a></div>
</form>
</div></div>
@section Scripts{<partial name="_ValidationScriptsPartial" />}
