@model List<GharsPlatform.Models.Core.Notification>
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    ViewData["Title"] = T("Notifications", "الإشعارات");
    ViewData["PageTitle"] = T("Notifications", "الإشعارات");
    string TypeLabel(NotificationType t) => t switch
    {
        NotificationType.Info => T("Information", "معلومات"),
        NotificationType.Success => T("Success", "نجاح"),
        NotificationType.Warning => T("Warning", "تنبيه"),
        NotificationType.Danger => T("Urgent", "عاجل"),
        NotificationType.System => T("System", "النظام"),
        _ => t.ToString()
    };
    string TargetLabel(NotificationTargetType t) => t switch
    {
        NotificationTargetType.All => T("All users", "جميع المستخدمين"),
        NotificationTargetType.Role => T("Role", "دور"),
        NotificationTargetType.Organization => T("Organization", "جهة"),
        NotificationTargetType.User => T("User", "مستخدم"),
        _ => t.ToString()
    };
}
<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="fw-semibold">@T("Notifications", "الإشعارات")</div>
    <a class="btn btn-sm btn-primary super-admin-action" href="/Admin/Notifications/Create"><i class="bi bi-plus-lg"></i> @T("Send notification", "إرسال إشعار")</a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>@T("ID", "الرقم")</th>
                <th>@T("Title", "العنوان")</th>
                <th>@T("Sent to", "أُرسل إلى")</th>
                <th>@T("Type", "النوع")</th>
                <th>@T("Created", "تاريخ الإنشاء")</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var n in Model)
            {
                <tr>
                    <td>@n.Id</td>
                    <td class="fw-semibold">@(ar && !string.IsNullOrWhiteSpace(n.TitleAr) ? n.TitleAr : n.TitleEn)</td>
                    <td>@TargetLabel(n.TargetType)</td>
                    <td>@TypeLabel(n.Type)</td>
                    <td><span dir="ltr">@n.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
