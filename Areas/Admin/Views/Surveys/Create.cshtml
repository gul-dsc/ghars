@model GharsPlatform.Controllers.Admin.SurveysController.SurveyVm
@using GharsPlatform.Models.Core
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    var official = Model.Purpose == SurveyPurpose.OfficialSatisfaction;
    ViewData["Title"] = official ? T("New official survey", "استبيان رسمي جديد") : T("New activity survey", "استبيان نشاط جديد");
    ViewData["PageTitle"] = ViewData["Title"];
}

<h1 class="h4 mb-3">@ViewData["Title"]</h1>

<form method="post" class="card border-0 shadow-sm rounded-4 p-3 p-md-4">
    @Html.AntiForgeryToken()
    <partial name="_SurveyForm" model="Model" />

    <div class="d-flex justify-content-between align-items-center mt-4 flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">@T("Cancel", "إلغاء")</a>
        <button class="btn btn-primary" type="submit"><i class="bi bi-check2 me-1"></i>@T("Create with default questions", "إنشاء مع الأسئلة الافتراضية")</button>
    </div>
    <div class="text-muted small mt-2">@T("The default questions are the set already used by the Ghars survey engine. You can edit, reorder, add and remove them on the next screen.", "الأسئلة الافتراضية هي المجموعة المستخدمة حالياً في محرك استبيانات غرس. يمكنك تعديلها وإعادة ترتيبها وإضافة أسئلة وحذفها في الشاشة التالية.")</div>
</form>
