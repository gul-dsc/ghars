@model GharsPlatform.Controllers.Admin.NewsController.NewsVm
@{
    ViewData["Title"] = "Create News Item";
    ViewData["PageTitle"] = "Create News Item";
}
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <form method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Title (EN)</label>
                    <input class="form-control" asp-for="TitleEn" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Title (AR)</label>
                    <input class="form-control" asp-for="TitleAr" />
                </div>
                <div class="col-md-8">
                    <label class="form-label">URL (optional)</label>
                    <input class="form-control" asp-for="Url" placeholder="https://..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Priority</label>
                    <input class="form-control" asp-for="Priority" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Active</label>
                    <div class="form-check mt-2">
                        <input class="form-check-input" asp-for="IsActive" />
                        <label class="form-check-label">Enabled</label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a class="btn btn-outline-secondary" href="/Admin/News">Back</a>
                <button class="btn btn-primary" type="submit">Create</button>
            </div>

            <div class="text-danger small mt-2" asp-validation-summary="All"></div>
        </form>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
