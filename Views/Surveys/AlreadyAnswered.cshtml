@model GharsPlatform.Models.Core.Survey
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    ViewData["Title"] = T("Already submitted", "تم الإرسال مسبقاً");
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="card shadow-sm border-0 rounded-4 text-center">
            <div class="card-body p-4 p-md-5">
                <img src="~/img/brand/ghars-logo.png" alt="@T("Ghars Program", "برنامج غرس")" style="height:64px;width:auto;" class="mb-4" />

                <div class="display-6 text-success mb-3" aria-hidden="true"><i class="bi bi-check2-circle"></i></div>

                <h1 class="h4 mb-2">@T("You have already answered this survey", "لقد أجبت على هذا الاستبيان بالفعل")</h1>
                <p class="text-muted mb-1">@(ar ? Model.TitleAr : Model.TitleEn)</p>
                <p class="text-muted mb-4">@T("Thank you — one response per participant is counted.", "شكراً لك — تُحتسب استجابة واحدة لكل مشارك.")</p>

                <a class="btn btn-outline-primary" href="~/">@T("Go to the Ghars home page", "الانتقال إلى الصفحة الرئيسية لغرس")</a>
            </div>
        </div>
    </div>
</div>
