@model GharsPlatform.Controllers.AccountController.ResetPasswordVm
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    ViewData["Title"] = T("Choose a new password", "اختر كلمة مرور جديدة");
}
<div class="row justify-content-center">
    <div class="col-md-6 col-xl-5">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <h3 class="mb-2">@T("Choose a new password", "اختر كلمة مرور جديدة")</h3>
                <p class="text-muted small mb-4">@T("At least 10 characters, with an uppercase letter, a lowercase letter, a digit and a symbol.", "10 أحرف على الأقل، تتضمن حرفاً كبيراً وحرفاً صغيراً ورقماً ورمزاً.")</p>
                <form method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Token" />
                    <div class="mb-3">
                        <label class="form-label">@T("Email", "البريد الإلكتروني")</label>
                        <input class="form-control" asp-for="Email" readonly dir="ltr" autocomplete="username" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@T("New password", "كلمة المرور الجديدة")</label>
                        <input class="form-control" asp-for="Password" type="password" autocomplete="new-password" />
                        <span class="text-danger small" asp-validation-for="Password"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@T("Confirm new password", "تأكيد كلمة المرور الجديدة")</label>
                        <input class="form-control" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                        <span class="text-danger small" asp-validation-for="ConfirmPassword"></span>
                    </div>
                    <button class="btn btn-primary w-100" type="submit">@T("Save password", "حفظ كلمة المرور")</button>
                    <div class="text-danger small mt-3" asp-validation-summary="ModelOnly"></div>
                </form>
                <div class="mt-3 small"><a asp-controller="Account" asp-action="ForgotPassword">@T("Request a new link", "طلب رابط جديد")</a></div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
