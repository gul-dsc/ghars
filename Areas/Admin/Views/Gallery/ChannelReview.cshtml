@model GharsPlatform.Models.Core.GalleryItem
@using GharsPlatform.Helpers
@using GharsPlatform.Models.Core
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    string N(Organization? o) => ar ? (o?.NameAr ?? o?.NameEn ?? "") : (o?.NameEn ?? o?.NameAr ?? "");
    var history = ViewBag.History as List<OfferingHistoryEntry> ?? new();
    var canReview = ChannelWorkflow.DscCanReview(Model.ApprovalStatus);
    // Reviewers see the file whatever its state: the endpoint grants DSC access to unapproved content.
    var src = !string.IsNullOrWhiteSpace(Model.FilePath) ? $"/protected-files/gallery/{Model.Id}" : Model.ExternalUrl;
    ViewData["Title"] = T("Ghars Channel Review", "مراجعة قناة غرس");
    ViewData["PageTitle"] = ViewData["Title"];
}

<nav aria-label="@T("Breadcrumb", "مسار التنقل")">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/Admin/Gallery/MediaItems">@T("Ghars Channel", "قناة غرس")</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(ar ? Model.TitleAr : Model.TitleEn)</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">@(ar ? Model.TitleAr : Model.TitleEn)</h1>
        <div class="text-muted">
            <i class="bi bi-building me-1" aria-hidden="true"></i>@N(Model.Organization)
            <span class="mx-1">·</span>@ChannelWorkflow.CategoryLabel(Model.ChannelCategory ?? ChannelCategory.Awareness)
            <span class="mx-1">·</span>@Model.MediaDate.ToString("yyyy-MM-dd")
        </div>
    </div>
    <span class="badge @ChannelWorkflow.StatusBadgeClass(Model.ApprovalStatus)">
        <i class="bi @ChannelWorkflow.StatusIcon(Model.ApprovalStatus) me-1" aria-hidden="true"></i>@ChannelWorkflow.StatusLabel(Model.ApprovalStatus)
    </span>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card border-0 rounded-4 shadow-sm">
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.FilePath))
                {
                    if (ChannelWorkflow.IsVideo(Model))
                    {
                        <video src="@src" controls class="w-100 rounded" style="max-height:60vh;background:#000">
                            @T("Your browser cannot play this video.", "متصفحكم لا يدعم تشغيل هذا الفيديو.")
                        </video>
                    }
                    else
                    {
                        <img src="@src" alt="@(ar ? Model.TitleAr : Model.TitleEn)" class="w-100 rounded" style="max-height:60vh;object-fit:contain" />
                    }
                }
                else if (!string.IsNullOrWhiteSpace(Model.ExternalUrl))
                {
                    <p class="mb-2">@T("External link submitted for review", "رابط خارجي مقدم للمراجعة"):</p>
                    <a href="@Model.ExternalUrl" target="_blank" rel="noopener noreferrer" dir="ltr">@Model.ExternalUrl</a>
                }
                else if (Model.LibraryItem is not null)
                {
                    <p class="mb-2">@T("Linked Digital Library publication", "إصدار مرتبط في المكتبة الرقمية"):</p>
                    <a href="/Admin/Library/Categories" class="btn btn-outline-success btn-sm">
                        @(ar ? Model.LibraryItem.TitleAr : Model.LibraryItem.TitleEn)
                    </a>
                }

                <hr />
                <dl class="row mb-0 small">
                    <dt class="col-sm-3">@T("Title (English)", "العنوان بالإنجليزية")</dt><dd class="col-sm-9" dir="ltr">@Model.TitleEn</dd>
                    <dt class="col-sm-3">@T("Title (Arabic)", "العنوان بالعربية")</dt><dd class="col-sm-9" dir="rtl">@Model.TitleAr</dd>
                    <dt class="col-sm-3">@T("Description (English)", "الوصف بالإنجليزية")</dt><dd class="col-sm-9" dir="ltr">@(string.IsNullOrWhiteSpace(Model.DescriptionEn) ? "—" : Model.DescriptionEn)</dd>
                    <dt class="col-sm-3">@T("Description (Arabic)", "الوصف بالعربية")</dt><dd class="col-sm-9" dir="rtl">@(string.IsNullOrWhiteSpace(Model.DescriptionAr) ? "—" : Model.DescriptionAr)</dd>
                    <dt class="col-sm-3">@T("Season", "الموسم")</dt><dd class="col-sm-9">@(ar ? Model.Season?.TitleAr : Model.Season?.TitleEn)</dd>
                    <dt class="col-sm-3">@T("Submitted", "تاريخ الإرسال")</dt><dd class="col-sm-9">@(Model.SubmittedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 rounded-4 shadow-sm mb-3">
            <div class="card-header bg-white border-0 pt-3"><h2 class="h6 mb-0">@T("Review decision", "قرار المراجعة")</h2></div>
            <div class="card-body">
                @if (canReview)
                {
                    <form method="post" asp-action="ReviewChannelContent">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label" for="channelReviewNotes">@T("Notes to the entity", "ملاحظات للجهة")</label>
                            <textarea class="form-control" id="channelReviewNotes" name="notes" rows="4" maxlength="2000"
                                      placeholder="@T("Required when returning or rejecting.", "مطلوبة عند الإعادة أو الرفض.")"></textarea>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" name="status" value="@ChannelApprovalStatus.Approved" class="btn btn-success">
                                <i class="bi bi-check-circle me-1" aria-hidden="true"></i>@T("Approve and publish", "اعتماد ونشر")
                            </button>
                            <button type="submit" name="status" value="@ChannelApprovalStatus.ReturnedForCorrection" class="btn btn-warning">
                                <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>@T("Return for correction", "إعادة للتعديل")
                            </button>
                            <button type="submit" name="status" value="@ChannelApprovalStatus.Rejected" class="btn btn-outline-danger">
                                <i class="bi bi-x-circle me-1" aria-hidden="true"></i>@T("Reject", "رفض")
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="text-muted small mb-0">
                        <i class="bi bi-info-circle me-1" aria-hidden="true"></i>@ChannelWorkflow.Explain(Model.ApprovalStatus)
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ReviewNotes))
                {
                    <hr />
                    <h3 class="h6">@T("Previous notes", "الملاحظات السابقة")</h3>
                    <p class="small mb-0">@Model.ReviewNotes</p>
                }
            </div>
        </div>

        <div class="card border-0 rounded-4 shadow-sm">
            <div class="card-header bg-white border-0 pt-3"><h2 class="h6 mb-0">@T("History", "السجل")</h2></div>
            <ul class="list-group list-group-flush small">
                @foreach (var h in history)
                {
                    var label = ChannelWorkflow.AuditActionLabel(h.Action);
                    if (label is null) { continue; }
                    <li class="list-group-item d-flex justify-content-between gap-2">
                        <span>@label</span><span class="text-muted">@h.AtUtc.ToString("yyyy-MM-dd HH:mm")</span>
                    </li>
                }
                @if (!history.Any(h => ChannelWorkflow.AuditActionLabel(h.Action) is not null))
                {
                    <li class="list-group-item text-muted">@T("No recorded activity yet.", "لا يوجد سجل بعد.")</li>
                }
            </ul>
        </div>
    </div>
</div>
