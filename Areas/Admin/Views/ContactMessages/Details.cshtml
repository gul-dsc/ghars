@model GharsPlatform.Models.Core.ContactMessage
@using System.Globalization
@{
    ViewData["Title"] = "Contact Message";
    ViewData["PageTitle"] = "Contact Message";
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var replySubject = Uri.EscapeDataString("Re: " + Model.Subject);
}
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <a class="btn btn-sm btn-outline-secondary" href="/Admin/ContactMessages"><i class="bi bi-arrow-left"></i> Back to messages</a>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-success" href="mailto:@Model.Email?subject=@replySubject">
            <i class="bi bi-reply"></i> Reply by email
        </a>
        @if (User.IsInRole("Super Admin"))
        {
            <form method="post" asp-area="Admin" asp-controller="ContactMessages" asp-action="Delete" asp-route-id="@Model.Id" class="d-inline"
                  onsubmit="return confirm('Permanently delete this message? This cannot be undone.');">
                @Html.AntiForgeryToken()
                <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
            </form>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4">
            <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
                <h2 class="h5 fw-bold mb-0">@Model.Subject</h2>
                <span class="badge text-bg-@ContactLabels.StatusBadge(Model.Status)">@ContactLabels.Status(Model.Status, ar)</span>
            </div>
            <div class="text-muted small mb-3">
                @ContactLabels.Topic(Model.Topic, ar)
                <span class="mx-2">•</span>
                @Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC
            </div>
            @* The sender wrote plain text; render it as plain text with line breaks preserved. *@
            <div style="white-space: pre-wrap;">@Model.Message</div>
        </div></div>

        <div class="card border-0 shadow-sm rounded-4 mt-4"><div class="card-body p-4">
            <h3 class="h6 fw-bold mb-3">Handling</h3>
            <form method="post" asp-area="Admin" asp-controller="ContactMessages" asp-action="SetStatus" asp-route-id="@Model.Id">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label">Status</label>
                    <select class="form-select" name="status">
                        @foreach (var status in Enum.GetValues<ContactMessageStatus>())
                        {
                            <option value="@status" selected="@(status == Model.Status)">@ContactLabels.Status(status, ar)</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Internal notes</label>
                    <textarea class="form-control" name="adminNotes" rows="4" maxlength="2000"
                              placeholder="Not visible to the sender.">@Model.AdminNotes</textarea>
                </div>
                <button class="btn btn-primary" type="submit">Save</button>
            </form>
        </div></div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4">
            <h3 class="h6 fw-bold mb-3">Sender</h3>
            <dl class="row mb-0 small">
                <dt class="col-5 text-muted fw-normal">Name</dt>
                <dd class="col-7">@Model.FullName</dd>

                <dt class="col-5 text-muted fw-normal">Email</dt>
                <dd class="col-7"><a href="mailto:@Model.Email">@Model.Email</a></dd>

                @if (!string.IsNullOrWhiteSpace(Model.Phone))
                {
                    <dt class="col-5 text-muted fw-normal">Phone</dt>
                    <dd class="col-7" dir="ltr">@Model.Phone</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.OrganizationName))
                {
                    <dt class="col-5 text-muted fw-normal">Organization</dt>
                    <dd class="col-7">@Model.OrganizationName</dd>
                }

                <dt class="col-5 text-muted fw-normal">Language</dt>
                <dd class="col-7">@(Model.SubmittedCulture == "ar" ? "Arabic" : "English")</dd>

                <dt class="col-5 text-muted fw-normal">Signed in</dt>
                <dd class="col-7">@(string.IsNullOrWhiteSpace(Model.SubmittedByUserId) ? "No (anonymous visitor)" : "Yes")</dd>

                @if (!string.IsNullOrWhiteSpace(Model.SubmittedFromIp))
                {
                    <dt class="col-5 text-muted fw-normal">IP address</dt>
                    <dd class="col-7" dir="ltr">@Model.SubmittedFromIp</dd>
                }

                @if (Model.HandledAtUtc is { } handledAt)
                {
                    <dt class="col-5 text-muted fw-normal">Closed</dt>
                    <dd class="col-7">@handledAt.ToString("yyyy-MM-dd HH:mm") UTC</dd>
                }
            </dl>
        </div></div>

        <div class="card border-0 shadow-sm rounded-4 mt-4"><div class="card-body p-4">
            <h3 class="h6 fw-bold mb-2">Replying</h3>
            <p class="text-muted small mb-0">
                This platform does not send email, so replies are not recorded here. Reply from your own
                mailbox using the button above, then set the status to <strong>Resolved</strong> so the
                queue reflects what has actually been answered.
            </p>
        </div></div>
    </div>
</div>
