@model List<GharsPlatform.Models.Core.LibraryCategory>
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    string L(string? en, string? arText) => ar ? (string.IsNullOrWhiteSpace(arText) ? en ?? "" : arText) : (en ?? arText ?? "");
    ViewData["Title"] = T("Digital Library categories", "تصنيفات المكتبة الرقمية");
    ViewData["PageTitle"] = ViewData["Title"];
}
<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="fw-semibold">@T("Digital Library", "المكتبة الرقمية")</div>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-secondary" href="/Admin/Library/Items">@T("Items", "الإصدارات")</a>
        <a class="btn btn-sm btn-primary super-admin-action" href="/Admin/Library/CreateItem"><i class="bi bi-plus-lg"></i> @T("Add item", "إضافة إصدار")</a>
        <a class="btn btn-sm btn-primary super-admin-action" href="/Admin/Library/CreateCategory"><i class="bi bi-plus-lg"></i> @T("Create category", "إنشاء تصنيف")</a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>@T("ID", "الرقم")</th>
                <th>@T("Name", "الاسم")</th>
                <th>@T("Order", "الترتيب")</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Id</td>
                    <td class="fw-semibold">@L(c.NameEn, c.NameAr)</td>
                    <td>@c.SortOrder</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3"><a class="btn btn-primary super-admin-action" href="/Admin/Library/CreateCategory"><i class="bi bi-plus-lg"></i> @(Model.Any() ? T("Create category", "إنشاء تصنيف") : T("Create the first category", "إنشاء التصنيف الأول"))</a></div>
