@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    ViewData["Title"] = T("Access denied", "تم رفض الوصول");
}
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4 p-md-5">
        <h3 class="mb-2 text-danger"><i class="bi bi-shield-lock me-2"></i>@T("Access denied", "تم رفض الوصول")</h3>
        <p class="text-muted">@T("Your account doesn't have permission to open this page. If you think it should, contact your platform administrator.", "لا يملك حسابك صلاحية فتح هذه الصفحة. إذا كنت تعتقد أنه يجب أن يملكها، فتواصل مع مسؤول المنصة.")</p>
        <a class="btn btn-primary" href="/">@T("Back to home", "العودة إلى الرئيسية")</a>
    </div>
</div>
