@model GharsPlatform.Controllers.Admin.LibraryController.CategoryVm
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    ViewData["Title"] = T("Create Digital Library category", "إنشاء تصنيف في المكتبة الرقمية");
    ViewData["PageTitle"] = ViewData["Title"];
}
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <form method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">@T("Name (English)", "الاسم بالإنجليزية")</label>
                    <input class="form-control" asp-for="NameEn" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">@T("Name (Arabic)", "الاسم بالعربية")</label>
                    <input class="form-control" asp-for="NameAr" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@T("Display order", "ترتيب العرض")</label>
                    <input class="form-control" asp-for="SortOrder" />
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a class="btn btn-outline-secondary" href="/Admin/Library/Categories">@T("Back", "رجوع")</a>
                <button class="btn btn-primary" type="submit">@T("Create category", "إنشاء التصنيف")</button>
            </div>

            <div class="text-danger small mt-2" asp-validation-summary="All"></div>
        </form>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
