@model List<GharsPlatform.Models.Core.Organization>
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    ViewData["Title"] = T("Organizations", "الجهات");
    ViewData["PageTitle"] = T("Organizations", "الجهات");
}
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <div class="fw-semibold">@T("Organizations", "الجهات")</div>
    @if (User.IsInRole("Super Admin")) { <a class="btn btn-sm btn-primary super-admin-action" asp-area="Admin" asp-controller="Organizations" asp-action="Create"><i class="bi bi-plus-lg"></i> @T("Add organization", "إضافة جهة")</a> }
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-secondary" href="/Admin/Organizations?status=Pending">@T("Pending approval", "بانتظار الاعتماد")</a>
        <a class="btn btn-sm btn-outline-secondary" href="/Admin/Organizations?status=Approved">@T("Approved", "معتمدة")</a>
        <a class="btn btn-sm btn-outline-secondary" href="/Admin/Organizations?status=Rejected">@T("Rejected", "مرفوضة")</a>
        <a class="btn btn-sm btn-outline-secondary" href="/Admin/Organizations">@T("All", "الكل")</a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>@T("ID", "الرقم")</th>
                <th>@T("Name", "الاسم")</th>
                <th>@T("Type", "النوع")</th>
                <th>@T("Status", "الحالة")</th>
                <th>@T("Created", "تاريخ الإنشاء")</th>
                <th><span class="visually-hidden">@T("Actions", "الإجراءات")</span></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>@o.Id</td>
                    <td class="fw-semibold">@(ar && !string.IsNullOrWhiteSpace(o.NameAr) ? o.NameAr : o.NameEn)</td>
                    <td>@GharsPlatform.Controllers.Admin.OrganizationText.TypeLabel(o.OrganizationType)</td>
                    <td><span class="badge @GharsPlatform.Controllers.Admin.OrganizationText.StatusBadgeClass(o.Status)">@GharsPlatform.Controllers.Admin.OrganizationText.StatusLabel(o.Status)</span></td>
                    <td>@o.CreatedAtUtc.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-primary super-admin-action" href="/Admin/Organizations/Details/@o.Id">@T("Details", "التفاصيل")</a>
                        @if (User.IsInRole("Super Admin")) { <a class="btn btn-sm btn-outline-primary" asp-area="Admin" asp-controller="Organizations" asp-action="Edit" asp-route-id="@o.Id">@T("Edit", "تعديل")</a> }
                        @if (User.IsInRole("Super Admin"))
                        {
                            <form method="post" asp-area="Admin" asp-controller="Organizations" asp-action="Delete" asp-route-id="@o.Id" class="d-inline"
                                  data-confirm="@T($"Remove {o.NameEn} from the platform? It will no longer appear in lists or be available for booking. Its users, their links to it and its past bookings are kept.", $"إزالة {(string.IsNullOrWhiteSpace(o.NameAr) ? o.NameEn : o.NameAr)} من المنصة؟ لن تظهر في القوائم ولن تكون متاحة للحجز. يبقى مستخدموها وروابطهم بها وحجوزاتها السابقة.")"
                                  data-confirm-ok="@T("Remove", "إزالة")">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger" type="submit">@T("Remove", "إزالة")</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
