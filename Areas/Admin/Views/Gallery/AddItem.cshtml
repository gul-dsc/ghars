@model GharsPlatform.Controllers.Admin.GalleryController.MediaItemVm
@using GharsPlatform.Models.Core
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    var album = ViewBag.Album as MediaAlbum;
    var albumTitle = ar ? (string.IsNullOrWhiteSpace(album?.TitleAr) ? album?.TitleEn : album?.TitleAr) : album?.TitleEn;
    ViewData["Title"] = T("Add media", "إضافة وسائط");
    ViewData["PageTitle"] = ViewData["Title"];
}
<form method="post" enctype="multipart/form-data" class="card p-4 rounded-4 border-0 shadow-sm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="AlbumId" />
    <h5 class="mb-3">@T("Add media to:", "إضافة وسائط إلى:") <bdi>@albumTitle</bdi></h5>
    <div class="row g-3">
        <div class="col-md-3"><label class="form-label">@T("Media type", "نوع الوسائط")</label><select class="form-select" asp-for="MediaType"><option value="Image">@T("Image", "صورة")</option><option value="Video">@T("Video", "فيديو")</option><option value="Pdf">@T("PDF", "ملف PDF")</option></select></div>
        <div class="col-md-3"><label class="form-label">@T("Display order", "ترتيب العرض")</label><input class="form-control" asp-for="SortOrder" type="number" /></div>
        <div class="col-md-6"><label class="form-label">@T("Upload file", "رفع ملف")</label><input class="form-control" type="file" asp-for="File" accept="image/*,video/*,.pdf,application/pdf" /></div>
        <div class="col-12"><label class="form-label">@T("External link (YouTube, video or PDF URL)", "رابط خارجي (يوتيوب أو فيديو أو ملف PDF)")</label><input class="form-control" asp-for="ExternalUrl" dir="ltr" /></div>
        <div class="col-md-6"><label class="form-label">@T("Caption (English)", "الوصف المختصر بالإنجليزية")</label><input class="form-control" asp-for="CaptionEn" /></div>
        <div class="col-md-6"><label class="form-label">@T("Caption (Arabic)", "الوصف المختصر بالعربية")</label><input class="form-control" asp-for="CaptionAr" /></div>
        <div class="col-12 d-flex gap-2"><button class="btn btn-primary">@T("Add media", "إضافة الوسائط")</button><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.AlbumId">@T("Cancel", "إلغاء")</a></div>
    </div>
</form>
