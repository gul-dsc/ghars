@model List<GharsPlatform.Models.Core.RewardRedemption>
@{
    ViewData["Title"] = "Reward Redemptions";
    ViewData["PageTitle"] = "Reward Redemptions";
}
<div class="d-flex align-items-center justify-content-between mb-3">
    <a class="btn btn-sm btn-outline-secondary" href="/Admin/Rewards"><i class="bi bi-arrow-left"></i> Back</a>
    <div class="fw-semibold">Redemptions</div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Reward</th>
                <th>UserId</th>
                <th>Status</th>
                <th>Redeemed</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Id</td>
                    <td>@r.Reward?.TitleEn</td>
                    <td class="text-truncate" style="max-width:220px;">@r.UserId</td>
                    <td><span class="badge text-bg-secondary">@r.Status</span></td>
                    <td>@r.RedeemedAtUtc.ToString("yyyy-MM-dd")</td>
                    <td class="text-end">
                        <form method="post" action="/Admin/Rewards/Decide/@r.Id" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="action" value="approve" />
                            <button class="btn btn-sm btn-outline-success" type="submit">Approve</button>
                        </form>
                        <form method="post" action="/Admin/Rewards/Decide/@r.Id" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="action" value="deliver" />
                            <button class="btn btn-sm btn-outline-primary" type="submit">Delivered</button>
                        </form>
                        <form method="post" action="/Admin/Rewards/Decide/@r.Id" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="action" value="reject" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">Reject</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
