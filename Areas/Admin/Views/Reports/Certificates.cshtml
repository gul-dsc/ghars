@model List<GharsPlatform.Models.Core.Certificate>
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    var recipients = ViewBag.Recipients as Dictionary<string, string[]> ?? new();
}
@{
    ViewData["Title"] = T("Certificates report", "تقرير الشهادات");
    ViewData["PageTitle"] = ViewData["Title"];
}
<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>@T("ID", "الرقم")</th>
                <th>@T("Certificate no.", "رقم الشهادة")</th>
                <th>@T("Activity", "النشاط")</th>
                <th>@T("Recipient", "المستلم")</th>
                <th>@T("Status", "الحالة")</th>
                <th>@T("Issued", "تاريخ الإصدار")</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Id</td>
                    <td class="fw-semibold"><bdi>@c.CertificateNo</bdi></td>
                    <td>@(ar && !string.IsNullOrWhiteSpace(c.Activity?.TitleAr) ? c.Activity!.TitleAr : c.Activity?.TitleEn)</td>
                    <td>@if (!string.IsNullOrEmpty(c.UserId) && recipients.TryGetValue(c.UserId, out var who)) { <div class="fw-semibold">@(string.IsNullOrWhiteSpace(who[0]) ? who[1] : who[0])</div><div class="small text-muted">@who[1]</div> } else { <span class="text-muted small">@T("Unknown user", "مستخدم غير معروف")</span> }</td>
                    <td>@(c.Status == GharsPlatform.Models.Core.CertificateStatus.Revoked ? T("Revoked", "ملغاة") : T("Issued", "صادرة"))</td>
                    <td>@c.IssuedAtUtc.ToString("yyyy-MM-dd")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
