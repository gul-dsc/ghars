@model GharsPlatform.Controllers.AccountController.LoginVm
@{
    ViewData["Title"] = "Login";
}
<div class="row justify-content-center">
    <div class="col-md-6 col-xl-5">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <h3 class="mb-3">Sign in</h3>
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input class="form-control" asp-for="Email" />
                        <span class="text-danger small" asp-validation-for="Email"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input class="form-control" asp-for="Password" type="password" />
                        <span class="text-danger small" asp-validation-for="Password"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="RememberMe" />
                        <label class="form-check-label">Remember me</label>
                    </div>
                    <button class="btn btn-primary w-100" type="submit">Login</button>
                    <div class="text-danger small mt-3" asp-validation-summary="All"></div>
                </form>
                <div class="mt-3 small text-muted">Access is created by the system administrator.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
