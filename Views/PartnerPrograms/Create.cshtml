@model GharsPlatform.ViewModels.PartnerProgramVm
@using GharsPlatform.ViewModels
@using System.Globalization
@{
 var ar=CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar"; string T(string e,string a)=>ar?a:e;
 ViewData["Title"]=T("New Program","برنامج جديد");
}
@await Html.PartialAsync("_OrganizationWorkspaceHeader", new WorkspaceHeaderVm
{
    Variant = WorkspaceHeaderVariant.Compact,
    PageTitleEn = "New Program",
    PageTitleAr = "برنامج جديد"
})
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="mb-1">@T("New Program","برنامج جديد")</h1>
        <div class="text-muted">@T("Save it as a draft while you work, then submit it for DSC approval. Clubs see it only once it is approved.",
                                   "احفظه كمسودة أثناء العمل عليه، ثم أرسله لاعتماد مجلس دبي الرياضي. لا يظهر للأندية إلا بعد اعتماده.")</div>
    </div>
    <a class="btn btn-outline-secondary" href="/partner/programs">@T("Back to My Programs","العودة إلى برامجي")</a>
</div>

@* enctype is required for the supporting-document input in _Form: without it the browser posts the
   file names and no file content, and the upload fails silently. *@
<form method="post" action="/partner/programs/create" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    @await Html.PartialAsync("_Form", Model)

    <div class="d-flex gap-2 mb-5">
        <button class="btn btn-outline-primary" type="submit" name="action" value="draft">@T("Save Draft","حفظ كمسودة")</button>
        <button class="btn btn-success" type="submit" name="action" value="submit">@T("Submit for Approval","إرسال للاعتماد")</button>
        <a class="btn btn-outline-secondary" href="/partner/programs">@T("Cancel","إلغاء")</a>
    </div>
</form>
