@using GharsPlatform.Models.Core
@using System.Globalization
@{
    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string en,string ar)=>isAr?ar:en;
    string A(Activity a)=>isAr?(a.TitleAr??a.TitleEn):(a.TitleEn??a.TitleAr);
    // Direct (entity-first) requests have no linked program - show the requested subject instead.
    string BookingTitle(BookingRequest b)=>b.Activity!=null?A(b.Activity):(string.IsNullOrWhiteSpace(b.Subject)?T("Direct request","طلب مباشر"):b.Subject!);
    string O(Organization? o)=>isAr?(o?.NameAr??o?.NameEn??""):(o?.NameEn??o?.NameAr??"");
    string ActivityTypeText(ActivityType type)=>type switch{ActivityType.Lecture=>T("Lecture","محاضرة"),ActivityType.Event=>T("Event","فعالية"),ActivityType.Workshop=>T("Workshop","ورشة عمل"),ActivityType.TrainingProgram=>T("Training","تدريب"),ActivityType.Course=>T("Course","دورة"),ActivityType.Activity=>T("Activity","نشاط"),_=>type.ToString()};
    string StatusText(BookingStatus st)=>st switch{BookingStatus.Pending=>T("Pending Partner Approval","بانتظار موافقة الشريك"),BookingStatus.Approved=>T("Approved","موافق عليه"),BookingStatus.Rejected=>T("Rejected","مرفوض"),BookingStatus.Cancelled=>T("Cancelled","ملغي"),BookingStatus.PartnerProposedNewTime=>T("Awaiting your response","بانتظار ردكم"),BookingStatus.Confirmed=>T("Confirmed","مؤكد"),BookingStatus.ClubRejectedProposedTimes=>T("Awaiting partner update","بانتظار تحديث الشريك"),_=>st.ToString()};
    var club = ViewBag.Club as Organization;
    var bookings = ViewBag.Bookings as List<BookingRequest> ?? new();
    var programs = ViewBag.Programs as List<Activity> ?? new();
    var notes = ViewBag.Notifications as List<NotificationDelivery> ?? new();
    var partners = ViewBag.Partners as List<Organization> ?? new();
    ViewData["Title"] = T("Club Dashboard", "لوحة النادي");
    var pending = bookings.Count(x=>x.Status==BookingStatus.Pending);
    var awaiting = bookings.Count(x=>x.Status==BookingStatus.PartnerProposedNewTime);
    var confirmed = bookings.Count(x=>x.Status==BookingStatus.Confirmed||x.Status==BookingStatus.Approved);
    var rejected = bookings.Count(x=>x.Status==BookingStatus.Rejected||x.Status==BookingStatus.ClubRejectedProposedTimes);
    var upcoming = bookings.Count(x => (x.Status == BookingStatus.Confirmed || x.Status == BookingStatus.Approved) && (x.ConfirmedStartUtc ?? x.Activity?.StartDateTime ?? DateTime.MinValue) >= DateTime.UtcNow);
}
<div class="dashboard-hero d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
    <div>
        <h1 class="h3 mb-1">@(O(club)==""?T("Club Dashboard","لوحة النادي"):O(club))</h1>
        <div>@T("Track partner responses, confirmed programs, and bookings requiring your response.", "متابعة ردود الشركاء والبرامج المؤكدة والحجوزات التي تتطلب ردكم.")</div>
    </div>
    <a class="btn btn-light fw-bold" href="/bookings/create"><i class="bi bi-calendar-plus me-1"></i>@T("New booking request", "طلب حجز جديد")</a>
</div>
@if(awaiting>0){<div class="required-action-banner"><i class="bi bi-bell me-2"></i>@T("You have partner proposed time options waiting for your decision.", "لديكم أوقات مقترحة من الشريك بانتظار قراركم.")</div>}

@{
    // Ghars Annual Report for the current season: a status and a shortcut only. The report itself is
    // completed on its own screen; the dashboard's job is to make the obligation visible.
    var reportSeason = ViewBag.AnnualReportSeason as Season;
    var annualReport = ViewBag.AnnualReport as GharsAnnualReport;
}
@if (reportSeason is not null)
{
    <div class="metric-card mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h2 class="h5 mb-1">
                    <i class="bi bi-file-earmark-text me-1" aria-hidden="true"></i>@GharsPlatform.Helpers.AnnualReportWorkflow.ReportTitle
                </h2>
                <div class="small text-muted">
                    @GharsPlatform.Helpers.AnnualReportWorkflow.SportsSeason: @(isAr ? reportSeason.TitleAr : reportSeason.TitleEn)
                </div>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                @if (annualReport is null)
                {
                    <span class="badge text-bg-secondary">
                        <i class="bi bi-dash-circle me-1" aria-hidden="true"></i>@T("Not started", "لم يبدأ")
                    </span>
                    <a class="btn btn-sm btn-success" href="/annual-report/edit/@reportSeason.Id">@T("Start report", "بدء التقرير")</a>
                }
                else
                {
                    <span class="badge @GharsPlatform.Helpers.AnnualReportWorkflow.BadgeClass(annualReport.Status)">
                        <i class="bi @GharsPlatform.Helpers.AnnualReportWorkflow.Icon(annualReport.Status) me-1" aria-hidden="true"></i>@GharsPlatform.Helpers.AnnualReportWorkflow.Label(annualReport.Status)
                    </span>
                    @if (GharsPlatform.Helpers.AnnualReportWorkflow.ClubCanEdit(annualReport.Status))
                    {
                        <a class="btn btn-sm btn-success" href="/annual-report/edit/@reportSeason.Id">@T("Continue", "متابعة")</a>
                    }
                    <a class="btn btn-sm btn-outline-secondary" href="/annual-report/view/@annualReport.Id">@T("View", "عرض")</a>
                }
            </div>
        </div>
    </div>
}
<form class="ghars-filter-card row g-2 align-items-end" method="get"><div class="col-md-2"><label class="form-label">@T("Partner","الشريك")</label><select class="form-select" name="partnerId"><option value="">@T("All","الكل")</option>@foreach(var p in partners){<option value="@p.Id" selected="@(ViewBag.PartnerId==p.Id)">@O(p)</option>}</select></div><div class="col-md-2"><label class="form-label">@T("Program type","نوع البرنامج")</label><select class="form-select" name="programType"><option value="">@T("All","الكل")</option>@foreach(ActivityType t in Enum.GetValues(typeof(ActivityType))){<option value="@t" selected="@(ViewBag.ProgramType==t)">@ActivityTypeText(t)</option>}</select></div><div class="col-md-2"><label class="form-label">@T("Status","الحالة")</label><select class="form-select" name="status"><option value="">@T("All","الكل")</option>@foreach(BookingStatus s in Enum.GetValues(typeof(BookingStatus))){<option value="@s" selected="@(ViewBag.Status==s)">@StatusText(s)</option>}</select></div><div class="col-md-2"><label class="form-label">@T("From","من")</label><input class="form-control" type="date" name="from" value="@ViewBag.From" /></div><div class="col-md-2"><label class="form-label">@T("To","إلى")</label><input class="form-control" type="date" name="to" value="@ViewBag.To" /></div><div class="col-md-2"><label class="form-label">@T("Program title","عنوان البرنامج")</label><input class="form-control" name="q" value="@ViewBag.Query" /></div><div class="col-12"><button class="btn btn-primary">@T("Apply filters","تطبيق الفلاتر")</button><a class="btn btn-outline-secondary" href="/club">@T("Reset","إعادة تعيين")</a></div></form>
<div class="row g-3 mb-4"><div class="col-md"><div class="metric-card"><div class="label">@T("Pending requests","طلبات قيد الانتظار")</div><div class="value">@pending</div></div></div><div class="col-md"><div class="metric-card"><div class="label">@T("Awaiting your decision","بانتظار قراركم")</div><div class="value">@awaiting</div></div></div><div class="col-md"><div class="metric-card"><div class="label">@T("Confirmed","مؤكدة")</div><div class="value">@confirmed</div></div></div><div class="col-md"><div class="metric-card"><div class="label">@T("Rejected","مرفوضة")</div><div class="value">@rejected</div></div></div><div class="col-md"><div class="metric-card"><div class="label">@T("Upcoming confirmed","قادمة مؤكدة")</div><div class="value">@upcoming</div></div></div></div>
<div class="action-panel mb-4"><h2 class="h5">@T("Pending Your Response", "بانتظار ردكم")</h2>@if(bookings.Any(x=>x.Status==BookingStatus.PartnerProposedNewTime)){<div class="table-responsive"><table class="table"><tbody>@foreach(var b in bookings.Where(x=>x.Status==BookingStatus.PartnerProposedNewTime)){<tr><td>@(BookingTitle(b))</td><td>@O(b.PartnerOrganization)</td><td>@b.ProposedTimeOptions.Count(x=>x.IsActive) @T("options","خيارات")</td><td class="text-end"><a class="btn btn-sm btn-warning" href="/bookings/details/@b.Id">@T("Respond","رد")</a></td></tr>}</tbody></table></div>}else{<div class="empty-state">@T("No partner responses are waiting for your decision.", "لا توجد ردود من الشركاء بانتظار قراركم.")</div>}</div>
<div class="row g-3 mb-4"><div class="col-lg-6"><div class="chart-card"><h3 class="h6">@T("Bookings by status","الحجوزات حسب الحالة")</h3><canvas id="statusChart"></canvas></div></div><div class="col-lg-6"><div class="chart-card"><h3 class="h6">@T("Bookings by partner","الحجوزات حسب الشريك")</h3><canvas id="partnerChart"></canvas></div></div></div>
<div class="row g-3"><div class="col-lg-8"><div class="metric-card"><h2 class="h5">@T("My bookings", "حجوزاتي")</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>@T("Reference","المرجع")</th><th>@T("Program","البرنامج")</th><th>@T("Partner","الشريك")</th><th>@T("Status","الحالة")</th><th></th></tr></thead><tbody>@foreach(var b in bookings.Take(12)){<tr><td class="small fw-semibold">@b.ReferenceNumber</td><td>@(BookingTitle(b))</td><td>@O(b.PartnerOrganization)</td><td><span class="badge text-bg-secondary">@StatusText(b.Status)</span></td><td><a class="btn btn-sm btn-outline-primary" href="/bookings/details/@b.Id">@T("Details","تفاصيل")</a></td></tr>}@if(!bookings.Any()){<tr><td colspan="5"><div class="empty-state">@T("No bookings found.", "لا توجد حجوزات.")</div></td></tr>}</tbody></table></div></div></div><div class="col-lg-4"><div class="metric-card mb-3"><h2 class="h5">@T("Partner response notifications", "إشعارات ردود الشركاء")</h2>@foreach(var n in notes){<a class="d-block border-bottom py-2 text-decoration-none" href="/notifications/open/@n.Id"><strong>@(isAr?n.Notification!.TitleAr:n.Notification!.TitleEn)</strong><div class="small text-muted">@(isAr?n.Notification!.MessageAr:n.Notification!.MessageEn)</div></a>}@if(!notes.Any()){<div class="empty-state">@T("No unread notifications.", "لا توجد إشعارات غير مقروءة.")</div>}</div><div class="metric-card"><h2 class="h5">@T("Available partner programs", "برامج الشركاء المتاحة")</h2>@foreach(var a in programs.Take(8)){<div class="border-bottom py-2"><strong>@A(a)</strong><div class="small text-muted">@ActivityTypeText(a.Type) · @a.StartDateTime.ToString("g") · @T("Capacity","السعة") @a.Capacity</div><a class="btn btn-sm btn-outline-primary mt-2" href="/bookings/create?activityId=@a.Id">@T("Book", "حجز")</a></div>}</div></div></div>
@section Scripts{<script src="https://cdn.jsdelivr.net/npm/chart.js"></script><script>new Chart(document.getElementById('statusChart'),{type:'doughnut',data:{labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Enum.GetNames(typeof(BookingStatus)))),datasets:[{data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Enum.GetValues(typeof(BookingStatus)).Cast<BookingStatus>().Select(s=>bookings.Count(b=>b.Status==s)).ToList()))}]}});new Chart(document.getElementById('partnerChart'),{type:'bar',data:{labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(partners.Select(p=>O(p)).ToList())),datasets:[{label:'@T("Bookings","الحجوزات")',data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(partners.Select(p=>bookings.Count(b=>b.PartnerOrganizationId==p.Id)).ToList()))}]}});</script>}
