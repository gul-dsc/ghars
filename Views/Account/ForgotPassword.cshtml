@model GharsPlatform.Controllers.AccountController.ForgotPasswordVm
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    ViewData["Title"] = T("Forgot password", "نسيت كلمة المرور");
}
<div class="row justify-content-center">
    <div class="col-md-6 col-xl-5">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <h3 class="mb-2">@T("Forgot password", "نسيت كلمة المرور")</h3>
                <p class="text-muted small mb-4">@T("Enter the email address you sign in with. We will email you a link to choose a new password.", "أدخل البريد الإلكتروني الذي تستخدمه لتسجيل الدخول، وسنرسل لك رابطاً لاختيار كلمة مرور جديدة.")</p>
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">@T("Email", "البريد الإلكتروني")</label>
                        <input class="form-control" asp-for="Email" autocomplete="username" dir="ltr" />
                        <span class="text-danger small" asp-validation-for="Email"></span>
                    </div>
                    <button class="btn btn-primary w-100" type="submit">@T("Send reset link", "إرسال رابط إعادة التعيين")</button>
                    <div class="text-danger small mt-3" asp-validation-summary="ModelOnly"></div>
                </form>
                <div class="mt-3 small"><a asp-controller="Account" asp-action="Login">@T("Back to sign in", "العودة إلى تسجيل الدخول")</a></div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
