@model GharsPlatform.Controllers.Admin.NewsController.NewsVm
@{
    var ar = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    ViewData["Title"] = T("Add news item", "إضافة خبر");
    ViewData["PageTitle"] = ViewData["Title"];
}
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <form method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">@T("Title (English)", "العنوان (بالإنجليزية)")</label>
                    <input class="form-control" asp-for="TitleEn" dir="ltr" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">@T("Title (Arabic)", "العنوان (بالعربية)")</label>
                    <input class="form-control" asp-for="TitleAr" dir="rtl" />
                </div>
                <div class="col-md-8">
                    <label class="form-label">@T("Link (optional)", "الرابط (اختياري)")</label>
                    <input class="form-control" asp-for="Url" placeholder="https://..." dir="ltr" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@T("Priority", "الأولوية")</label>
                    <input class="form-control" asp-for="Priority" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@T("Status", "الحالة")</label>
                    <div class="form-check mt-2">
                        <input class="form-check-input" asp-for="IsActive" />
                        <label class="form-check-label" asp-for="IsActive">@T("Active", "نشط")</label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a class="btn btn-outline-secondary" href="/Admin/News">@T("Back", "رجوع")</a>
                <button class="btn btn-primary" type="submit">@T("Add news item", "إضافة الخبر")</button>
            </div>

            <div class="text-danger small mt-2" asp-validation-summary="All"></div>
        </form>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
