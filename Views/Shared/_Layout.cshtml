@using System.Globalization
@using Microsoft.AspNetCore.Identity
@using GharsPlatform.Data
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using GharsPlatform.Models.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject AppDbContext LayoutDb

@{
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = culture == "ar";
    var dir = isRtl ? "rtl" : "ltr";
    var title = (ViewData["Title"] as string) ?? "Ghars Platform";
    var isAuthenticated = SignInManager.IsSignedIn(User);

    var isAdmin = User.IsInRole("Super Admin") || User.IsInRole("DSC Admin");
    var isPartner = User.IsInRole("Partner Admin");
    var isClub = User.IsInRole("Club Admin");
    var isOrgAdmin = isAdmin || isPartner || isClub || User.IsInRole("Academy Admin");
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
    var bellItems = new List<GharsPlatform.Models.Core.NotificationDelivery>();
    var unreadCount = 0;
    if (isAuthenticated && !string.IsNullOrWhiteSpace(currentUserId))
    {
        unreadCount = await LayoutDb.NotificationDeliveries.CountAsync(x => x.UserId == currentUserId && x.ReadAtUtc == null);
        bellItems = await LayoutDb.NotificationDeliveries
            .Include(x => x.Notification)
            .Where(x => x.UserId == currentUserId && x.Notification != null)
            .OrderByDescending(x => x.Notification!.CreatedAtUtc)
            .Take(5)
            .ToListAsync();
    }
}
<!doctype html>
<html lang="@culture" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ghars-public-theme.css" asp-append-version="true" />

    @RenderSection("Head", required: false)
</head>
<body>
    <header class="ghars-header">
        <nav class="navbar navbar-expand-xl">
            <div class="container ghars-navbar-wrap">

                <!-- Left: Ghars logo only -->
                <a class="ghars-dsc-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/img/brand/ghars-logo.png" alt="Ghars" />
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <!-- Center nav -->
                    <ul class="navbar-nav mx-auto ghars-main-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">@(isRtl ? "الرئيسية" : "Home")</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">@(isRtl ? "عن غرس" : "About Us")</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Vision">@(isRtl ? "الرؤية والأهداف" : "Vision & Objectives")</a>
                        </li>

                        @* Booking replaces the former "Partners" information link: the implementing
                           entities are now presented as a booking entry point, not a directory.

                           It is hidden from Partner Admins: the page is a club catalogue of their
                           own offerings, and every action on it is one they cannot take. Their
                           equivalent entry points are Partner Dashboard and My Programs below. *@
                        @if (!isPartner)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Booking">@(isRtl ? "الحجز" : "Booking")</a>
                            </li>
                        }

                        @if (isAuthenticated)
                        {
                            @if (isPartner)
                            {
                                @* Two distinct partner responsibilities, kept as two links: the
                                   dashboard processes incoming booking requests, My Programs manages
                                   the offerings that attract them. *@
                                <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="PartnerDashboard" asp-action="Index">@(isRtl ? "لوحة الشريك" : "Partner Dashboard")</a></li>
                                <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="PartnerPrograms" asp-action="Index">@(isRtl ? "برامجي" : "My Programs")</a></li>
                            }

                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Library" asp-action="Index">@(isRtl ? "المكتبة الرقمية" : "Digital Library")</a>
                            </li>

                            @if (isClub)
                            {
                                <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Agenda" asp-action="Index">@(isRtl ? "الأجندة" : "Agenda")</a></li>
                                <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Kpi" asp-action="Index">@(isRtl ? "مؤشرات الأداء" : "KPI")</a></li>
                            }
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Gallery" asp-action="Index">@(isRtl ? "المعرض" : "Gallery")</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Surveys" asp-action="Index">@(isRtl ? "الاستبيانات" : "Surveys")</a></li>
                        }

                        @* Contact is deliberately the last navigation item, in both languages. In RTL
                           the list direction flips, so "last" reads as leftmost — which is correct. *@
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Contact">@(isRtl ? "تواصل معنا" : "Contact")</a>
                        </li>
                    </ul>

                    <!-- Right actions -->
                    <div class="ghars-top-actions d-flex align-items-center gap-2">

                        <form asp-area="" asp-controller="Culture" asp-action="Set" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <input type="hidden" name="culture" value="@(isRtl ? "en" : "ar")" />
                            <button class="btn btn-outline-secondary btn-sm ghars-lang-btn" type="submit">
                                @(isRtl ? "English" : "العربية")
                            </button>
                        </form>

                        @if (!isAuthenticated)
                        {
                            <a class="btn btn-outline-primary btn-sm ghars-auth-link"
                               asp-area=""
                               asp-controller="Account"
                               asp-action="Login"
                               asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")">
                                @(isRtl ? "تسجيل الدخول" : "Login")
                            </a>

                        }
                        else
                        {
                            @if (isAdmin)
                            {
                                <a class="btn btn-outline-primary btn-sm" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">@(isRtl ? "لوحة الإدارة" : "Dashboard")</a>
                            }
                            else if (isPartner)
                            {
                                <a class="btn btn-outline-success btn-sm" asp-area="" asp-controller="PartnerDashboard" asp-action="Index">@(isRtl ? "لوحة الشريك" : "Partner")</a>
                            }
                            else if (isClub)
                            {
                                <a class="btn btn-outline-success btn-sm" asp-area="" asp-controller="ClubDashboard" asp-action="Index">@(isRtl ? "لوحة النادي" : "Club")</a>
                            }

                            <div class="dropdown ghars-notification-menu">
                                <button class="btn btn-outline-secondary btn-sm position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                                    <i class="bi bi-bell"></i>
                                    @if (unreadCount > 0)
                                    {
                                        <span id="gharsBellBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">@unreadCount</span>
                                    }
                                    else
                                    {
                                        <span id="gharsBellBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">0</span>
                                    }
                                </button>
                                <div class="dropdown-menu dropdown-menu-end p-0 ghars-notification-dropdown">
                                    <div class="px-3 py-2 border-bottom fw-semibold">@(isRtl ? "الإشعارات" : "Notifications")</div>
                                    @if (bellItems.Count == 0)
                                    {
                                        <div class="px-3 py-3 text-muted small">@(isRtl ? "لا توجد إشعارات" : "No notifications")</div>
                                    }
                                    else
                                    {
                                        foreach (var item in bellItems)
                                        {
                                            var n = item.Notification!;
                                            <a class="dropdown-item py-2 @(item.ReadAtUtc == null ? "fw-semibold bg-light" : "")" href="/notifications/open/@item.Id">
                                                <div class="d-flex justify-content-between gap-2">
                                                    <span>@(isRtl ? n.TitleAr : n.TitleEn)</span>
                                                    @if (item.ReadAtUtc == null) { <span class="badge text-bg-warning">@(isRtl ? "مطلوب" : "Action")</span> }
                                                </div>
                                                <div class="small text-muted text-wrap">@(isRtl ? n.MessageAr : n.MessageEn)</div>
                                            </a>
                                        }
                                    }
                                    <div class="border-top"><a class="dropdown-item text-center small" href="/notifications">@(isRtl ? "عرض جميع الإشعارات" : "View All Notifications")</a></div>
                                </div>
                            </div>

                            <div class="dropdown">
                                <button class="btn btn-outline-dark btn-sm dropdown-toggle ghars-user-menu"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i>
                                    <span class="ghars-user-name">@User.Identity?.Name</span>
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end ghars-user-dropdown">
                                    <li class="dropdown-header text-muted small">@User.Identity?.Name</li>

                                    @if (isAdmin)
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                               asp-area=""
                                               asp-controller="Organization"
                                               asp-action="Create">
                                                <i class="bi bi-building-add me-2"></i>@(isRtl ? "تسجيل جهة" : "Register Organization")
                                            </a>
                                        </li>
                                    }

                                    @* "My Organizations" was removed from user-facing navigation. The
                                       route, the controller and every organization link and scoping
                                       rule behind it are untouched — this is a menu change only. *@

                                    @if (isAdmin)
                                    {
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>@(isRtl ? "لوحة الإدارة" : "Admin Dashboard")</a></li>
                                    }
                                    else if (isPartner)
                                    {
                                        <li><a class="dropdown-item" asp-area="" asp-controller="PartnerDashboard" asp-action="Index"><i class="bi bi-grid-1x2 me-2"></i>@(isRtl ? "لوحة الشريك" : "Partner Dashboard")</a></li>
                                    }
                                    else if (isClub)
                                    {
                                        <li><a class="dropdown-item" asp-area="" asp-controller="ClubDashboard" asp-action="Index"><i class="bi bi-grid-1x2 me-2"></i>@(isRtl ? "لوحة النادي" : "Club Dashboard")</a></li>
                                    }

                                    <li><hr class="dropdown-divider" /></li>

                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="px-3">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                                <i class="bi bi-box-arrow-right me-1"></i>@(isRtl ? "تسجيل الخروج" : "Logout")
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="py-4">
        <div class="container">
            @await Html.PartialAsync("~/Views/Shared/_Toasts.cshtml")
            @RenderBody()
        </div>
    </main>

    <footer class="border-top py-4 mt-4 bg-white">
        <div class="container d-flex flex-column flex-md-row align-items-center justify-content-between gap-2">
            <div class="text-muted small">© @DateTime.UtcNow.Year Ghars Platform</div>
            <div class="text-muted small">@(isRtl ? "منصة غرس" : "Ghars Platform")</div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>