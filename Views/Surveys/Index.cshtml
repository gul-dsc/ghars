@using GharsPlatform.Models.Core
@using System.Globalization
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string e, string a) => ar ? a : e;
    var officialSurveys = ViewBag.OfficialSurveys as List<Survey> ?? new();
    var activitySurveys = ViewBag.ActivitySurveys as List<Survey> ?? new();
    var answered = ViewBag.AnsweredSurveyIds as List<int> ?? new();
    ViewData["Title"] = T("Surveys", "الاستبيانات");

    string TakeUrl(Survey s) => s.PublicToken != null
        ? Url.Content($"~/surveys/take/{s.PublicToken}")
        : Url.Content($"~/surveys/{s.ActivityId}");
}

<div class="dashboard-hero mb-4">
    <h1 class="h3 mb-1">@T("Ghars Surveys", "استبيانات غرس")</h1>
    <div>@T("Share your feedback on the Ghars Program. Every survey is completed here, inside Ghars.", "شاركنا رأيك حول برنامج غرس. تُستكمل جميع الاستبيانات هنا داخل منصة غرس.")</div>
</div>

@if (User.IsInRole(GharsPlatform.Models.Identity.RoleNames.ClubAdmin))
{
    <div class="alert alert-light border d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <div class="fw-semibold">@T("Your club's satisfaction results", "نتائج الرضا الخاصة بناديك")</div>
            <div class="small text-muted">@T("Aggregate results from the official survey for your own club.", "النتائج المجمعة من الاستبيان الرسمي لناديك فقط.")</div>
        </div>
        <a class="btn btn-outline-primary" href="/surveys/results"><i class="bi bi-bar-chart me-1"></i>@T("View results", "عرض النتائج")</a>
    </div>
}

<h2 class="h5 mb-1"><i class="bi bi-clipboard-check me-2"></i>@T("Official Participant Satisfaction Survey", "استبيان قياس رضا المشاركين الرسمي")</h2>
<p class="text-muted small mb-3">@T("The official Ghars Program survey for the sports season. Its results are the source of the participant satisfaction indicator.", "الاستبيان الرسمي لبرنامج غرس للموسم الرياضي. نتائجه هي مصدر مؤشر رضا المشاركين.")</p>

<div class="row g-3 mb-5">
@foreach (var survey in officialSurveys)
{
    var title = ar ? survey.TitleAr : survey.TitleEn;
    var desc = ar ? survey.DescriptionAr : survey.DescriptionEn;
    var isAnswered = answered.Contains(survey.Id);
    <div class="col-md-6">
        <div class="metric-card h-100 d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                <h3 class="h6 fw-bold mb-0">@title</h3>
                <span class="badge text-bg-primary">@T("Official", "رسمي")</span>
            </div>
            @if (survey.Season != null)
            {
                <div class="small text-muted mb-2">@(ar ? survey.Season.TitleAr : survey.Season.TitleEn)</div>
            }
            <p class="text-muted flex-grow-1">@(string.IsNullOrWhiteSpace(desc) ? T("Official Ghars Program participant satisfaction survey.", "استبيان قياس رضا المشاركين الرسمي لبرنامج غرس.") : desc)</p>
            <div>
                @if (isAnswered)
                {
                    <span class="badge text-bg-success"><i class="bi bi-check2 me-1"></i>@T("Completed", "تم الإكمال")</span>
                }
                else
                {
                    <a class="btn btn-primary" href="@TakeUrl(survey)"><i class="bi bi-pencil-square me-1"></i>@T("Take the survey", "تعبئة الاستبيان")</a>
                }
            </div>
        </div>
    </div>
}
@if (!officialSurveys.Any())
{
    <div class="col-12"><div class="empty-state">@T("No official survey is currently open.", "لا يوجد استبيان رسمي مفتوح حالياً.")</div></div>
}
</div>

<h2 class="h5 mb-1"><i class="bi bi-stars me-2"></i>@T("Activity surveys", "استبيانات الأنشطة")</h2>
<p class="text-muted small mb-3">@T("Feedback on individual Ghars activities. Used for internal follow-up, separately from the official satisfaction indicator.", "ملاحظات حول أنشطة غرس الفردية. تُستخدم للمتابعة الداخلية بمعزل عن مؤشر الرضا الرسمي.")</p>

<div class="row g-3">
@foreach (var survey in activitySurveys)
{
    var title = ar ? survey.TitleAr : survey.TitleEn;
    var activityTitle = ar ? (survey.Activity?.TitleAr ?? survey.Activity?.TitleEn) : (survey.Activity?.TitleEn ?? survey.Activity?.TitleAr);
    var isAnswered = answered.Contains(survey.Id);
    <div class="col-md-6 col-xl-4">
        <div class="metric-card h-100 d-flex flex-column">
            <h3 class="h6 fw-bold mb-1">@title</h3>
            <div class="small text-muted mb-3">@activityTitle</div>
            <div class="mt-auto">
                @if (isAnswered)
                {
                    <span class="badge text-bg-success"><i class="bi bi-check2 me-1"></i>@T("Completed", "تم الإكمال")</span>
                }
                else
                {
                    <a class="btn btn-outline-primary w-100" href="@TakeUrl(survey)">@T("Take survey", "تعبئة الاستبيان")</a>
                }
            </div>
        </div>
    </div>
}
@if (!activitySurveys.Any())
{
    <div class="col-12"><div class="empty-state">@T("No activity surveys are open right now.", "لا توجد استبيانات أنشطة متاحة حالياً.")</div></div>
}
</div>
