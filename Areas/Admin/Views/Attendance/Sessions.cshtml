@model List<GharsPlatform.Models.Core.AttendanceSession>
@{
    ViewData["Title"] = "Attendance";
    ViewData["PageTitle"] = "Attendance Sessions";
}
<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="fw-semibold">Attendance Sessions</div>
    <a class="btn btn-sm btn-primary" href="/Admin/Attendance/CreateSession"><i class="bi bi-plus-lg"></i> New Session</a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Activity</th>
                <th>Start</th>
                <th>End</th>
                <th>Attendees</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Id</td>
                    <td class="fw-semibold">@s.Activity?.TitleEn</td>
                    <td>@s.SessionStartUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@(s.SessionEndUtc?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                    <td>@(s.AttendanceRecords?.Count ?? 0)</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" href="/Admin/Attendance/SessionDetails/@s.Id">Details</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
